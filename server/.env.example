# Lemon's Portal — variables de entorno (server)
# Copiar a .env y completar. NUNCA comitear este archivo con valores reales.

# ── Postgres ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host:5432/lemons?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32   (mínimo 32 chars)
JWT_SECRET=

# ── Externos ─────────────────────────────────────────────────────────────────
# AI agent (OpenClaw) y bot WhatsApp comparten esta key
AI_API_KEY=

# Cloudinary (avatars + emojis custom)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (mails de verify + reset password)
RESEND_API_KEY=
MAIL_FROM=Lemon's <noreply@lemonsarg.com>

# Instagram Graph API (DM y mensajes)
IG_ACCESS_TOKEN=
IG_WEBHOOK_TOKEN=lemons_ig_webhook_change_me

# Anthropic (Claude API) — usado por replies AI, ideas de contenido y stories
ANTHROPIC_KEY=
# Opcional: activar crons de IG (ideas/publisher/stories) en dev
# En NODE_ENV=production se activan siempre
IG_ENABLE_CRON=

# Mock del publisher de IG — SOLO PARA TESTS LOCALES.
# Vacío → llama a Graph API real.
# 'true' → simula success en cada paso (no toca IG).
# 'fail' → simula error en el primer fetch (para testear retries).
IG_PUBLISHER_MOCK=

# ── App ──────────────────────────────────────────────────────────────────────
PORT=4000
APP_URL=https://app.lemonsarg.com

# Importantísimo: setear en producción para activar hardenings
NODE_ENV=production

# ── Notificaciones de error a Telegram (opcional) ────────────────────────────
# Crear bot en @BotFather → /newbot → te da el TOKEN
# Para obtener TELEGRAM_CHAT_ID: 1) Mandale un /start a tu bot.
# 2) Abrí https://api.telegram.org/bot<TOKEN>/getUpdates → leés "chat":{"id":...}
# Si las dos están vacías, no se manda nada (no rompe).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_NAME=Lemon's Portal

# ── Microlink API (opcional, para scrap de productos en QuickQuote) ──────────
# Sin key: funciona pero rate-limited a 50/día.
# Con key (microlink.io free): 100/día.
MICROLINK_API_KEY=

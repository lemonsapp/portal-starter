# Portal Starter — variables de entorno (server)
# Copiar a server/.env y completar. NUNCA comitear con valores reales.
#
# Lo que va acá es SÓLO el bootstrap pre-wizard: lo mínimo para que el
# server arranque y el admin pueda entrar a /admin/setup. Las demás API
# keys (Cloudinary, Resend, Telegram, etc.) las pega el cliente final desde
# el wizard y se guardan encriptadas con MASTER_KEY en la tabla app_config.

# ── Postgres ─────────────────────────────────────────────────────────────────
# Neon free tier alcanza al inicio. URL con sslmode=require.
DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secreto para firmar JWTs. Mínimo 32 chars, recomendado 64.
# Generar con: openssl rand -hex 32
JWT_SECRET=

# ── Encriptación de configs del wizard ───────────────────────────────────────
# Master key para encriptar las API keys que pegue el cliente final desde el
# setup wizard. AES-256-GCM. CRÍTICO: si se pierde, hay que re-pegar todas
# las keys desde el wizard. NO se rota automáticamente.
# Generar con: openssl rand -hex 32
MASTER_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
PORT=4000
# URL pública del frontend que ven los usuarios.
# Dev: http://localhost:5173 — Prod: https://portal.tucliente.com
APP_URL=http://localhost:5173

# URL pública de la API (para el notification_url del webhook de MercadoPago).
# En Render NO hace falta: se usa RENDER_EXTERNAL_URL automáticamente.
# Setear solo fuera de Render (otro host, o dev con túnel tipo ngrok).
# API_PUBLIC_URL=https://api.tucliente.com

# Setear "production" en prod para activar hardenings (CSP estricta, HSTS, etc.)
NODE_ENV=development

# ── Notificaciones a Telegram (opcional, fallback de bootstrap) ──────────────
# El cliente final pega bot_token + chat_id desde el wizard (encriptados).
# Estas vars son fallback para alertas tempranas (errores de boot antes de
# que el wizard exista). Vacías → no se envía nada (no rompe).
# Crear bot: @BotFather → /newbot → token
# Obtener chat_id: mandale /start al bot, luego abrir
#   https://api.telegram.org/bot<TOKEN>/getUpdates → leer "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

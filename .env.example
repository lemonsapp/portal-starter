# Portal Starter — variables de entorno
# Copiar este archivo a .env y completar con valores reales.
# NUNCA commitear .env con valores reales.

# ── Postgres ─────────────────────────────────────────────────────────────
# Crear en https://console.neon.tech, copiar el connection string.
DATABASE_URL=postgresql://user:pass@host.neon.tech/db?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────
# Secreto para firmar JWTs. Mínimo 32 chars, recomendado 64.
# Generar con: openssl rand -hex 32
JWT_SECRET=

# ── Encriptación de configs del wizard ───────────────────────────────────
# Master key para encriptar API keys que el cliente final pega desde el wizard
# (Cloudinary, Resend, Telegram, etc.). AES-256-GCM.
# CRÍTICO: si se pierde, hay que re-pegar todas las keys desde el wizard.
# Generar con: openssl rand -hex 32
MASTER_KEY=

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# URL del frontend. En producción debe ser el dominio REAL del portal
# (ej: https://hgrowshop.com). De acá se deriva la config de Face ID / Touch ID.
APP_URL=http://localhost:5173

# ── Biométrico / Passkeys (WebAuthn — Face ID, Touch ID, Windows Hello) ────
# Para que el login biométrico funcione en producción, el "dominio del passkey"
# (RP_ID) y el origin deben matchear el dominio donde se sirve el portal.
# Por defecto se DERIVAN de APP_URL, así que normalmente NO hace falta setear
# nada acá si APP_URL apunta al dominio real (apex). Seteá estas solo para
# override o para aceptar varios orígenes:
#   WEBAUTHN_RP_ID=hgrowshop.com                  # dominio registrable, sin https:// ni puerto
#   WEBAUTHN_ORIGIN=https://hgrowshop.com         # origin completo; acepta lista separada por comas
#   # WEBAUTHN_ORIGIN=https://hgrowshop.com,https://www.hgrowshop.com
# Importante: usar el APEX (hgrowshop.com) como RP_ID — un passkey del apex
# sirve también en www, pero no al revés.

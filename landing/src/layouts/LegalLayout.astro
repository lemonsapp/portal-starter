---
// Layout para páginas legales (Términos y Condiciones / Privacidad y Seguridad).
// Documento de lectura: fondo claro, tipografía legible, ancho acotado.
import BaseLayout from "./BaseLayout.astro";

const { title, subtitle, updated, description, canonical } = Astro.props;
---
<BaseLayout title={`${title} — Holistic Growshop`} description={description} canonical={canonical}>
    <main class="legal">
        <div class="legal__inner">
            <a class="legal__back" href="/">← Volver al inicio</a>
            <h1 class="legal__title">{title}</h1>
            {subtitle && <p class="legal__subtitle">{subtitle}</p>}
            <p class="legal__updated">Última actualización: {updated}</p>
            <div class="legal__body">
                <slot />
            </div>
            <div class="legal__note">
                Este documento constituye un texto legal informativo. Ante cualquier consulta podés
                escribirnos a <a href="mailto:contacto@hgrowshop.com">contacto@hgrowshop.com</a>.
            </div>
        </div>
    </main>
</BaseLayout>

<style is:global>
    .legal {
        background: #f6f5f1;
        color: #1c1c1a;
        padding: clamp(5rem, 4rem + 6vw, 8rem) clamp(1.1rem, 4vw, 2rem) 5rem;
        font-family: 'Gotham', system-ui, sans-serif;
    }
    .legal__inner { max-width: 820px; margin: 0 auto; }
    .legal__back {
        display: inline-block; margin-bottom: 1.6rem;
        font-size: 0.85rem; font-weight: 700; color: #2E8F6E; text-decoration: none;
    }
    .legal__back:hover { text-decoration: underline; }
    .legal__title {
        font-size: clamp(2rem, 1.4rem + 3vw, 3.2rem); line-height: 1.05;
        font-weight: 900; letter-spacing: -0.02em; text-transform: uppercase; margin: 0 0 0.6rem;
    }
    .legal__subtitle { font-size: 1.05rem; color: #555; margin: 0 0 0.4rem; }
    .legal__updated { font-size: 0.8rem; color: #888; margin: 0 0 2.5rem; letter-spacing: 0.02em; }
    .legal__body { font-size: 0.97rem; line-height: 1.7; color: #2a2a28; }
    .legal__body h2 {
        font-size: 1.15rem; font-weight: 800; margin: 2.4rem 0 0.7rem;
        padding-top: 1.4rem; border-top: 1px solid #e2e0d8; color: #14140f;
    }
    .legal__body h2:first-child { border-top: none; padding-top: 0; margin-top: 0; }
    .legal__body h3 { font-size: 1rem; font-weight: 800; margin: 1.4rem 0 0.4rem; color: #14140f; }
    .legal__body p { margin: 0 0 0.9rem; }
    .legal__body ul, .legal__body ol { margin: 0 0 1rem; padding-left: 1.4rem; }
    .legal__body li { margin-bottom: 0.5rem; }
    .legal__body a { color: #2E8F6E; }
    .legal__body strong { color: #14140f; }
    .legal__body .legal__callout {
        background: #fff; border: 1px solid #e2e0d8; border-left: 3px solid #2E8F6E;
        border-radius: 8px; padding: 1rem 1.2rem; margin: 1.2rem 0; font-size: 0.93rem;
    }
    .legal__note {
        margin-top: 3rem; padding-top: 1.4rem; border-top: 1px solid #e2e0d8;
        font-size: 0.85rem; color: #777;
    }
    .legal__note a { color: #2E8F6E; }
</style>

---
// ComplementosIdeales — sección editorial DEBAJO del slider del home.
// Contiene la narrativa cinematográfica de los 2 complementos del
// catálogo (BIO-ESTIMULANTE + DAY-0) que antes vivían como panels 4/5
// del slider. El cliente los sacó del slider y pidió:
//   1) Header "COMPLEMENTOS IDEALES" con animación "armándose"
//      (chars-assemble desde scattered → posición final).
//   2) BIO y DAY-0 como panels scroll-driven debajo, conectados al
//      header con un "thread" visual.
//
// Composición:
//   HEADER (chars-assemble)
//   ├─ eyebrow "MÁS HOLISTIC · COMPLEMENTOS"
//   ├─ headline "COMPLEMENTOS / IDEALES" (chars scatter→assemble scrub)
//   ├─ DrawSVG divider con glow
//   └─ sub explicativo
//
//   THREAD SVG (DrawSVGPlugin scroll-linked)
//   └─ línea vertical mint que une header → 01 BIO → 02 DAY-0
//
//   PANEL BIO (scroll-driven enter)
//   ├─ Visual: bottle PNG + halo radial + decorative blob
//   ├─ Body:  num "01" stroke text + kicker + name + body + CTA
//   └─ Layout: alternating 2-col (text right en desktop)
//
//   PANEL DAY-0 (scroll-driven enter, layout reverse)
//   ├─ Visual: bottle PNG + halo + decorative blob
//   ├─ Body:  num "02" + kicker + name + body + CTA
//   └─ Layout: alternating 2-col (text left en desktop)
//
// Skills:
//   • gsap-plugins SplitText (chars per headline line)
//   • gsap-plugins DrawSVGPlugin (divider + thread vertical)
//   • gsap-plugins CustomEase (eases pre-registradas)
//   • gsap-scrolltrigger scrub (headline scatter→assemble + thread)
//   • gsap-scrolltrigger toggleActions (panels enter)
//   • gsap-timeline (panel sequences)
//   • gsap-utils.random (per-char scatter único)
//   • gsap-utils.toArray (selectors batch)
//   • gsap-core matchMedia (reduced-motion + breakpoints)
//   • gsap-performance (transforms + opacity + will-change)

// Datos canónicos de los 3 complementos (BIO + CLONER + DAY-0).
// Cloner se sumó por pedido del cliente como complemento del catálogo
// — gel enraizante para esquejes, primer paso del ciclo. Va entre
// BIO y DAY-0 manteniendo el orden cronológico del cultivo.
const complementos = [
    {
        slug: "bioestimulante",
        num: "01",
        kicker: "ACTIVADOR ORGÁNICO",
        nombre: "BIO ESTIMULANTE",
        tagline: "Activación radicular real.",
        body: "Bioestimulante orgánico producido en biorreactor industrial.",
        bullets: [
            "Ácidos húmicos",
            "Ácidos fúlvicos",
            "Ácidos carboxílicos y grupos fenoles",
            "Potasio soluble",
        ],
        href: "/bio-estimulante",
        ctaLabel: "VER BIO-ESTIMULANTE",
        // Producto PNG transparente (perspectiva grande)
        image: "/imagenes-web/productos/bio-estimulante/perspectiva-1-grande-rosa-sin-fondo.png",
        // Identidad cromática del producto
        bgColor: "#f8b9d5",      // rosa pastel saturado
        haloColor: "#f8b9d5",    // halo del producto
        accentText: "#FFC4DC",   // num + acento de texto en dark
    },
    {
        slug: "cloner",
        num: "02",
        kicker: "GEL ENRAIZANTE · ESQUEJES",
        nombre: "CLONER",
        tagline: "El primer paso del ciclo.",
        body: "Gel enraizante de alta adherencia para esquejes y plantines. Fórmula de contacto rápido que acelera el prendimiento radicular con mínima manipulación. Compatible con todo el catálogo Holistic.",
        href: "/cloner",
        ctaLabel: "VER CLONER",
        image: "/imagenes-web/ultimos-cambios/POTE-CLONER-HOME.png",
        bgColor: "#a78bfa",      // violeta pastel (intermedio entre rosa y amarillo)
        haloColor: "#c4b5fd",
        accentText: "#D6CAFB",
    },
    {
        slug: "day-0",
        num: "03",
        kicker: "FINISHER · COSECHA",
        nombre: "DAY 0",
        tagline: "Cierre limpio.",
        body: "Aplicado en los últimos riegos antes del corte, vacía reservorios internos de la planta y mejora el bouquet final. Diferencia entre cosecha técnica y excelente.",
        href: "/day-0",
        ctaLabel: "VER DAY-0",
        image: "/imagenes-web/productos/day-0/perspectiva-1-grande-amarillo-sin-fondo.png",
        bgColor: "#e6d54a",
        haloColor: "#f5e89c",
        accentText: "#F5E89C",
    },
];
---
<section class="cmp" data-complementos-ideales aria-label="Complementos ideales del catálogo">

    <!-- ===== THREAD SVG: línea vertical mint que une header→01→02 =====
         Vive como decorativo absolute fullheight. DrawSVGPlugin lo
         dibuja scroll-linked (scrub) — crece como el progreso de
         lectura. NO afecta layout, solo decora. -->
    <svg class="cmp__thread" data-cmp-thread-svg preserveAspectRatio="none" aria-hidden="true">
        <defs>
            <linearGradient id="cmpThreadGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0"   stop-color="#A7F5C8" stop-opacity="0"/>
                <stop offset="0.08" stop-color="#A7F5C8" stop-opacity="0.85"/>
                <stop offset="0.92" stop-color="#A7F5C8" stop-opacity="0.85"/>
                <stop offset="1"   stop-color="#A7F5C8" stop-opacity="0"/>
            </linearGradient>
        </defs>
        <line
            class="cmp__thread-line"
            data-cmp-thread
            x1="50%" y1="0%" x2="50%" y2="100%"
            stroke="url(#cmpThreadGrad)"
            stroke-width="1.4"
            stroke-linecap="round"
        />
    </svg>

    <!-- ===== HEADER (chars-assemble) ===== -->
    <header class="cmp__header" data-cmp-header>
        <p class="cmp__eyebrow" data-cmp-eyebrow>
            <span class="cmp__dot" aria-hidden="true"></span>
            <span>MÁS HOLISTIC · COMPLEMENTOS</span>
        </p>

        <h2 class="cmp__h" data-cmp-h>
            <span class="cmp__line" data-cmp-line>
                <span class="cmp__line-inner">COMPLEMENTOS</span>
            </span>
            <span class="cmp__line" data-cmp-line>
                <span class="cmp__line-inner">IDEALES</span>
            </span>
        </h2>

        <div class="cmp__divider" aria-hidden="true">
            <svg class="cmp__divider-svg" viewBox="0 0 400 16" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="cmpLine" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0"   stop-color="#A7F5C8" stop-opacity="0"/>
                        <stop offset="0.5" stop-color="#A7F5C8" stop-opacity="0.95"/>
                        <stop offset="1"   stop-color="#A7F5C8" stop-opacity="0"/>
                    </linearGradient>
                    <radialGradient id="cmpGlow">
                        <stop offset="0"   stop-color="#A7F5C8" stop-opacity="1"/>
                        <stop offset="0.5" stop-color="#A7F5C8" stop-opacity="0.45"/>
                        <stop offset="1"   stop-color="#A7F5C8" stop-opacity="0"/>
                    </radialGradient>
                </defs>
                <line class="cmp__divider-line" data-cmp-divider-line
                      x1="0" y1="8" x2="400" y2="8"
                      stroke="url(#cmpLine)" stroke-width="1.6" stroke-linecap="round"/>
                <circle class="cmp__divider-glow" data-cmp-divider-glow
                        cx="200" cy="8" r="14" fill="url(#cmpGlow)"/>
            </svg>
        </div>

        <p class="cmp__sub" data-cmp-sub>
            Esquejes + activación radicular orgánica + finalización pulida.
            Los 3 complementos que cierran cualquier sistema de cultivo.
        </p>
    </header>

    <!-- ===== PANELS (BIO + DAY-0) =====
         Layout alternado: BIO con visual izq, DAY-0 con visual der.
         CSS hace nth-of-type swap. Cada panel scroll-driven entrance
         + parallax sutil en el visual del producto. -->
    {complementos.map((c, i) => (
        <article
            class={`cmp__panel cmp__panel--${i % 2 === 0 ? "visual-left" : "visual-right"}`}
            data-cmp-panel
            data-cmp-index={i}
            data-cmp-slug={c.slug}
            style={`--cmp-panel-accent: ${c.bgColor}; --cmp-panel-halo: ${c.haloColor}; --cmp-panel-text-accent: ${c.accentText};`}
        >
            <!-- Marker en el thread vertical: dot mint pulsante a la
                 altura del num grande. Se conecta visualmente con la
                 línea SVG vertical (que pasa por el center axis). -->
            <span class="cmp__panel-marker" aria-hidden="true">
                <span class="cmp__panel-marker-ring"></span>
                <span class="cmp__panel-marker-dot"></span>
            </span>

            <!-- VISUAL: bottle PNG + halo + decorative bg blob -->
            <div class="cmp__panel-visual" data-cmp-visual>
                <span class="cmp__panel-blob" aria-hidden="true"></span>
                <span class="cmp__panel-halo" data-cmp-halo aria-hidden="true"></span>
                <img
                    class="cmp__panel-img"
                    data-cmp-img
                    src={c.image}
                    alt={`${c.nombre} — ${c.kicker}`}
                    loading="lazy"
                    draggable="false"
                />
            </div>

            <!-- BODY: num + kicker + name + body + cta -->
            <div class="cmp__panel-body">
                <span class="cmp__panel-num" data-cmp-num aria-hidden="true">{c.num}</span>
                <p class="cmp__panel-kicker" data-cmp-kicker>
                    <span class="cmp__panel-kicker-dot" aria-hidden="true"></span>
                    {c.kicker}
                </p>
                <h3 class="cmp__panel-name" data-cmp-name>{c.nombre}</h3>
                <p class="cmp__panel-tagline" data-cmp-tagline>{c.tagline}</p>
                <p class="cmp__panel-text" data-cmp-text>{c.body}</p>
                {c.bullets && (
                    <ul class="cmp__panel-bullets" data-cmp-bullets>
                        {c.bullets.map((b) => (
                            <li class="cmp__panel-bullet">
                                <span class="cmp__panel-bullet-mark" aria-hidden="true"></span>
                                <span>{b}</span>
                            </li>
                        ))}
                    </ul>
                )}
                <a
                    class="cmp__panel-cta"
                    data-cmp-cta
                    data-cursor="hover"
                    data-magnetic
                    data-magnetic-strength="0.18"
                    href={c.href}
                    aria-label={`Ver ficha de ${c.nombre}`}
                >
                    <span>{c.ctaLabel}</span>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6"/>
                    </svg>
                </a>
            </div>
        </article>
    ))}

</section>

<style>
    /* =====================================================================
       SECTION CONTAINER — bg dark cinematic (cliente revirtió a negro
       2026-05-19 tarde). LineasEstrella se queda en blanco, este vuelve
       a dark para mantener jerarquía visual: las líneas estrella son
       protagonistas light, los complementos cierran en dark cinematic.
       ===================================================================== */
    .cmp {
        position: relative;
        padding: clamp(72px, 14vh, 144px) clamp(20px, 5vw, 80px) clamp(96px, 18vh, 192px);
        background:
            radial-gradient(120% 80% at 50% 0%, rgba(167, 245, 200, 0.06), transparent 55%),
            radial-gradient(140% 90% at 50% 100%, rgba(46, 143, 110, 0.05), transparent 50%),
            #0a0a0a;
        color: #fff;
        overflow: hidden;
        isolation: isolate;
    }
    .cmp::before {
        /* línea decorativa top — separa visualmente del slider */
        content: "";
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        top: clamp(28px, 6vh, 56px);
        width: clamp(60px, 10vw, 140px);
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(167, 245, 200, 0.45), transparent);
        pointer-events: none;
    }

    /* =====================================================================
       THREAD VERTICAL SVG — conecta header → 01 → 02
       Position absolute, center axis, fullheight de la sección.
       DrawSVG anima stroke-dashoffset con scrub.
       ===================================================================== */
    .cmp__thread {
        position: absolute;
        top: 0;
        left: 50%;
        width: 2px;
        height: 100%;
        transform: translateX(-50%);
        z-index: 1;
        pointer-events: none;
        opacity: 0.85;
    }

    /* =====================================================================
       HEADER
       ===================================================================== */
    .cmp__header {
        position: relative;
        z-index: 3;
        text-align: center;
        max-width: min(900px, 90vw);
        margin: 0 auto clamp(72px, 12vh, 128px);
    }
    .cmp__eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.6em;
        margin: 0 0 clamp(24px, 4vh, 44px);
        font-family: var(--f-text);
        font-size: clamp(0.7rem, 0.9vw, 0.85rem);
        font-weight: 700;
        letter-spacing: 0.34em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.65);
    }
    .cmp__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #A7F5C8;
        box-shadow: 0 0 14px rgba(167, 245, 200, 0.8);
        display: inline-block;
    }
    .cmp__h {
        font-family: var(--f-display, 'Gotham', serif);
        font-weight: 900;
        /* Achicado vs versión anterior (era 2.8-9vw-7rem). Más legible
           y centrado entre las dos líneas — COMPLEMENTOS no se siente
           dominante respecto a IDEALES. */
        font-size: clamp(2.2rem, 7vw, 5.4rem);
        line-height: 0.94;
        letter-spacing: -0.014em;
        text-transform: uppercase;
        margin: 0 0 clamp(28px, 5vh, 56px);
        color: #fff;
        text-shadow: 0 4px 32px rgba(0, 0, 0, 0.5);
        /* Center alignment per text-align:center del parent .cmp__header.
           Ambas líneas (COMPLEMENTOS + IDEALES) quedan centradas con
           el mismo eje vertical. */
        text-align: center;
    }
    .cmp__line {
        display: block;
        padding: 0.06em 0;
        position: relative;
        /* Centra el inline-block del line-inner respecto al ancho del
           bloque. Dos líneas de chars diferentes anchos quedan centradas
           sobre el mismo eje. */
        text-align: center;
    }
    .cmp__line-inner {
        display: inline-block;
        will-change: transform;
    }
    /* "IDEALES" — acento mint sólido (NO gradient-text porque después
       de SplitText los chars son <div>, el background-clip:text del
       parent pierde su texto-target y queda invisible). Solid color
       + glow text-shadow para el pop editorial. */
    .cmp__line:last-child .cmp__line-inner {
        color: #A7F5C8;
        text-shadow:
            0 0 18px rgba(167, 245, 200, 0.5),
            0 0 60px rgba(46, 143, 110, 0.25),
            0 4px 32px rgba(0, 0, 0, 0.5);
    }
    /* SplitText genera .word inside line-inner — propaga color por si
       acaso el char wrapping pierde inheritance. */
    .cmp__line:last-child .cmp__line-inner .word,
    .cmp__line:last-child .cmp__line-inner .char {
        color: inherit;
    }

    /* Shimmer sweep removido por pedido del cliente — el flash horizontal
       generaba un "rectángulo transparente" visible sobre el bg dark
       que quedaba feo. Las animaciones GSAP del header son suficientes
       para el efecto cinematográfico. */
    .cmp__divider {
        width: clamp(220px, 36vw, 380px);
        margin: 0 auto clamp(28px, 5vh, 48px);
        opacity: 0.92;
    }
    .cmp__divider-svg {
        width: 100%;
        height: 16px;
        display: block;
        overflow: visible;
    }
    .cmp__divider-glow {
        filter: blur(0.5px);
        will-change: transform, opacity;
    }
    .cmp__sub {
        margin: 0 auto;
        max-width: 56ch;
        font-family: var(--f-text);
        font-size: clamp(0.98rem, 1.3vw, 1.18rem);
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.76);
    }

    /* =====================================================================
       PANELS (BIO + DAY-0) — alternating 2-col layout
       ===================================================================== */
    .cmp__panel {
        position: relative;
        z-index: 2;
        max-width: min(1180px, 92vw);
        margin: 0 auto clamp(80px, 14vh, 160px);
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: clamp(36px, 6vw, 72px);
        /* Decorative bg accent: muy sutil, color del producto al borde */
        padding: clamp(40px, 6vh, 80px) 0;
    }
    .cmp__panel:last-of-type {
        margin-bottom: 0;
    }

    /* Alternating layout: visual-left (BIO) / visual-right (DAY-0) */
    .cmp__panel--visual-right .cmp__panel-visual {
        order: 2;
    }
    .cmp__panel--visual-right .cmp__panel-body {
        order: 1;
    }

    /* ----- Panel Marker (dot pulsante sobre la línea thread) ----- */
    .cmp__panel-marker {
        position: absolute;
        top: clamp(40px, 6vh, 80px);
        left: 50%;
        transform: translate(-50%, 0);
        width: 24px;
        height: 24px;
        pointer-events: none;
        z-index: 4;
    }
    .cmp__panel-marker-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 1.5px solid rgba(167, 245, 200, 0.65);
        background: #0a0a0a;          /* "tapa" la línea atrás del dot */
        animation: cmp-marker-pulse 2.6s ease-in-out infinite;
    }
    .cmp__panel-marker-dot {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #A7F5C8;
        box-shadow: 0 0 12px rgba(167, 245, 200, 0.85);
    }
    @keyframes cmp-marker-pulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(167, 245, 200, 0.55); }
        50%      { box-shadow: 0 0 0 10px rgba(167, 245, 200, 0); }
    }

    /* ----- Panel Visual (bottle PNG + halo + blob) ----- */
    .cmp__panel-visual {
        position: relative;
        min-height: clamp(280px, 50vh, 480px);
        display: grid;
        place-items: center;
        padding: 0 clamp(16px, 2vw, 32px);
    }
    .cmp__panel-blob {
        /* decorative coloured blur del color del producto */
        position: absolute;
        inset: 10% 8%;
        background: var(--cmp-panel-accent, #f8b9d5);
        filter: blur(60px) saturate(1.1);
        opacity: 0.32;
        border-radius: 50%;
        z-index: 0;
        will-change: transform;
    }
    .cmp__panel-halo {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 70%;
        aspect-ratio: 1;
        border-radius: 50%;
        background:
            radial-gradient(
                circle at 50% 50%,
                color-mix(in srgb, var(--cmp-panel-halo, #f8b9d5) 35%, transparent) 0%,
                transparent 65%
            );
        filter: blur(28px);
        z-index: 1;
        will-change: transform, opacity;
    }
    .cmp__panel-img {
        position: relative;
        z-index: 2;
        max-width: 100%;
        max-height: clamp(280px, 52vh, 520px);
        width: auto;
        height: auto;
        object-fit: contain;
        filter: drop-shadow(0 28px 48px rgba(0, 0, 0, 0.45));
        will-change: transform;
        user-select: none;
    }

    /* ----- Panel Body (text column) ----- */
    .cmp__panel-body {
        position: relative;
        z-index: 2;
    }
    .cmp__panel-num {
        display: block;
        font-family: var(--f-display, 'Gotham', serif);
        font-weight: 900;
        font-size: clamp(4rem, 11vw, 8rem);
        line-height: 0.9;
        letter-spacing: -0.04em;
        color: transparent;
        -webkit-text-stroke: 1.4px rgba(167, 245, 200, 0.45);
        margin: 0 0 clamp(12px, 2vh, 24px);
        will-change: transform, opacity;
    }
    .cmp__panel-kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.6em;
        margin: 0 0 clamp(12px, 2vh, 18px);
        font-family: var(--f-text);
        font-size: clamp(0.7rem, 0.85vw, 0.82rem);
        font-weight: 700;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--cmp-panel-text-accent, #A7F5C8);
    }
    .cmp__panel-kicker-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        background: currentColor;
        box-shadow: 0 0 12px currentColor;
        opacity: 0.85;
    }
    .cmp__panel-name {
        font-family: var(--f-display, 'Gotham', serif);
        font-weight: 900;
        font-size: clamp(2rem, 4.5vw, 3.8rem);
        line-height: 0.96;
        letter-spacing: -0.018em;
        text-transform: uppercase;
        margin: 0 0 clamp(10px, 1.6vh, 18px);
        color: #fff;
    }
    .cmp__panel-tagline {
        margin: 0 0 clamp(12px, 2vh, 20px);
        font-family: var(--f-display, 'Gotham', sans-serif);
        font-style: normal;
        font-weight: 800;
        text-transform: uppercase;
        font-size: clamp(1.05rem, 1.6vw, 1.4rem);
        line-height: 1.25;
        letter-spacing: -0.01em;
        color: var(--cmp-panel-text-accent, #A7F5C8);
        opacity: 0.92;
    }
    .cmp__panel-text {
        margin: 0 0 clamp(14px, 2vh, 18px);
        max-width: 52ch;
        font-family: var(--f-text);
        font-size: clamp(0.95rem, 1.15vw, 1.08rem);
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.76);
    }
    .cmp__panel-bullets {
        margin: 0 0 clamp(24px, 4vh, 36px);
        padding: 0;
        list-style: none;
        display: grid;
        gap: 8px;
        max-width: 52ch;
    }
    .cmp__panel-bullet {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: var(--f-text);
        font-size: clamp(0.92rem, 1.1vw, 1.04rem);
        line-height: 1.45;
        color: rgba(255, 255, 255, 0.85);
    }
    .cmp__panel-bullet-mark {
        flex: 0 0 6px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--cmp-panel-text-accent, #A7F5C8);
        box-shadow: 0 0 8px var(--cmp-panel-text-accent, #A7F5C8);
    }
    .cmp__panel-cta {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px clamp(24px, 2.4vw, 32px);
        border-radius: 999px;
        border: 1px solid rgba(167, 245, 200, 0.45);
        background: linear-gradient(135deg, rgba(167, 245, 200, 0.06), rgba(255, 255, 255, 0.02));
        color: #fff;
        text-decoration: none;
        font-family: var(--f-display, 'Gotham', serif);
        font-weight: 800;
        font-size: clamp(0.85rem, 1vw, 1rem);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        line-height: 1;
        white-space: nowrap;
        transition:
            border-color 0.28s ease,
            background 0.28s ease,
            transform 0.28s cubic-bezier(.2,.8,.2,1),
            box-shadow 0.28s ease;
        will-change: transform;
        min-height: 44px;
    }

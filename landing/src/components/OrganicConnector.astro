---
// OrganicConnector — v4 "Nutrición Ascendente" 2026-05-23.
//
// Evolución de v3 (anti-gravity scroll-scrub) con narrativa botánica:
//   • TALLOS — paths verticales con stroke gradient esmeralda, crecen
//     bottom→top con DrawSVG scrub (mismo principio v3, pero ahora se
//     leen como "vine stems" no como tendrils abstractos).
//   • HOJAS — 6 hojas crecen lateralmente desde el tallo central a
//     medida que el usuario scrollea (scale 0→1 + rotate sutil, cada
//     una en su propia ventana de scroll).
//   • GOTAS DE FERTILIZANTE — teardrop shapes (no orbs genéricos) que
//     ascienden por los tallos con MotionPath REVERSE scrub. Color
//     glass mint con highlight superior — lectura "líquido nutritivo".
//   • HALO DE FOTOSÍNTESIS — radial gradient en el top que se intensifica
//     con scroll (al llegar a Productos Estrella el halo está full).
//
// Skills aplicadas:
//   • gsap-scrolltrigger scrub      → toda la animación tied a scroll
//   • gsap-plugins DrawSVGPlugin    → tallos + hojas growing bottom→top
//   • gsap-plugins MotionPathPlugin → drops ascending REVERSE
//   • gsap-core matchMedia          → reduced-motion + mobile
//
// El cliente controla el ritmo con su scroll — anti-gravity premium,
// alineado al brand (fertilizantes líquidos para nutrición vegetal).
---
<section
    class="oc"
    data-organic-connector
    aria-label="Nutrición ascendente — del asesoramiento a los productos"
>
    <div class="oc__bg" aria-hidden="true"></div>
    <div class="oc__halo" aria-hidden="true" data-oc-halo></div>

    <svg
        class="oc__svg"
        viewBox="0 0 1400 700"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        data-oc-svg
    >
        <defs>
            <!-- Drop glass gradient — fertilizante líquido con highlight -->
            <radialGradient id="oc-drop-grad" cx="35%" cy="25%" r="70%">
                <stop offset="0%"   stop-color="#FFFFFF" stop-opacity="1"/>
                <stop offset="30%"  stop-color="#E8FBF2" stop-opacity="0.95"/>
                <stop offset="70%"  stop-color="#A7F5C8" stop-opacity="0.85"/>
                <stop offset="100%" stop-color="#3DA86E" stop-opacity="0.55"/>
            </radialGradient>

            <!-- Stem gradient — invertido para legibilidad sobre el bg
                 dark→white del OC v5. Mint top (visible sobre dark) →
                 emerald deep bottom (visible sobre blanco/mint pale). -->
            <linearGradient id="oc-stem-grad"
                gradientUnits="userSpaceOnUse"
                x1="700" y1="700" x2="700" y2="0">
                <stop offset="0%"   stop-color="#1f5e44" stop-opacity="0.85"/>
                <stop offset="40%"  stop-color="#2E8F6E" stop-opacity="0.95"/>
                <stop offset="70%"  stop-color="#A7F5C8" stop-opacity="1"/>
                <stop offset="100%" stop-color="#E8FBF2" stop-opacity="1"/>
            </linearGradient>

            <!-- Leaf gradient — emerald body + edge lighter -->
            <linearGradient id="oc-leaf-grad"
                gradientUnits="objectBoundingBox"
                x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%"   stop-color="#1f5e44" stop-opacity="0.9"/>
                <stop offset="55%"  stop-color="#3DA86E" stop-opacity="0.95"/>
                <stop offset="100%" stop-color="#A7F5C8" stop-opacity="0.85"/>
            </linearGradient>

            <!-- Glow para gotas — soft, no goo -->
            <filter id="oc-drop-glow" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur in="SourceGraphic" stdDeviation="2.5" result="blur" />
                <feMerge>
                    <feMergeNode in="blur" />
                    <feMergeNode in="SourceGraphic" />
                </feMerge>
            </filter>

            <!-- Drop shape: teardrop con punta hacia arriba (porque sube) -->
            <symbol id="oc-drop-shape" viewBox="-12 -16 24 32" overflow="visible">
                <path d="M 0 -14 C 7 -8, 8 4, 4 12 C 2 15, -2 15, -4 12 C -8 4, -7 -8, 0 -14 Z"
                      fill="url(#oc-drop-grad)" />
                <!-- highlight sheen para vibe glass -->
                <ellipse cx="-2.5" cy="-7" rx="2.2" ry="4"
                         fill="#FFFFFF" opacity="0.55"
                         transform="rotate(-20 -2.5 -7)" />
            </symbol>

            <!-- Leaf shape: hoja apuntada saliendo desde base (0,0) hacia derecha -->
            <symbol id="oc-leaf-shape" viewBox="-2 -22 72 44" overflow="visible">
                <path d="M 0 0 C 18 -18, 48 -14, 68 0 C 48 14, 18 18, 0 0 Z"
                      fill="url(#oc-leaf-grad)" />
                <!-- Nervadura central -->
                <path d="M 2 0 L 64 0"
                      stroke="#1f5e44" stroke-width="1" stroke-opacity="0.45"
                      stroke-linecap="round" fill="none" />
                <!-- Nervaduras laterales sutiles -->
                <path d="M 18 -2 L 28 -10 M 18 2 L 28 10 M 38 -2 L 50 -9 M 38 2 L 50 9"
                      stroke="#1f5e44" stroke-width="0.6" stroke-opacity="0.32"
                      stroke-linecap="round" fill="none" />
            </symbol>
        </defs>

        <!-- ===== TALLOS — vine stems, crecen bottom→top con DrawSVG scrub ===== -->
        <g class="oc__stems"
           stroke="url(#oc-stem-grad)" fill="none"
           stroke-linecap="round" stroke-linejoin="round">
            <!-- Tallo central principal (más grueso, anchora la hoja gallery) -->
            <path class="oc__stem oc__stem--main" data-oc-stem data-i="0"
                d="M 700 700 C 680 580, 720 460, 700 340 C 685 240, 715 140, 700 0"
                stroke-width="3.6" />
            <!-- Tallos secundarios — más finos, sin hojas, parallax botánico -->
            <path class="oc__stem" data-oc-stem data-i="1"
                d="M 260 700 C 250 560, 275 420, 255 280 C 240 160, 270 80, 260 0"
                stroke-width="2.2" />
            <path class="oc__stem" data-oc-stem data-i="2"
                d="M 500 700 C 510 580, 485 440, 505 300 C 520 180, 495 90, 500 0"
                stroke-width="2.6" />
            <path class="oc__stem" data-oc-stem data-i="3"
                d="M 900 700 C 890 580, 915 440, 895 300 C 880 180, 905 90, 900 0"
                stroke-width="2.6" />
            <path class="oc__stem" data-oc-stem data-i="4"
                d="M 1140 700 C 1150 560, 1125 420, 1145 280 C 1160 160, 1130 80, 1140 0"
                stroke-width="2.2" />
        </g>

        <!-- ===== HOJAS — crecen lateralmente desde el tallo central =====
             Cada hoja tiene su (x,y) sobre el tallo central + rotación
             que la hace extender hacia un costado. data-progress es la
             fracción del scroll a la que esa hoja "florece". -->
        <g class="oc__leaves" data-oc-leaves>
            {[
                // x e y posicionados sobre el path del tallo principal.
                // rot=-160 → extiende hacia arriba-izquierda; rot=-20 → arriba-derecha.
                { x: 690, y: 610, rot: -160, scale: 1.05, p: 0.18 },
                { x: 712, y: 500, rot: -20,  scale: 1.15, p: 0.30 },
                { x: 700, y: 395, rot: -158, scale: 1.0,  p: 0.42 },
                { x: 708, y: 285, rot: -18,  scale: 1.1,  p: 0.55 },
                { x: 696, y: 175, rot: -155, scale: 0.95, p: 0.68 },
                { x: 706, y: 75,  rot: -22,  scale: 0.85, p: 0.80 },
            ].map((l, i) => (
                <g class="oc__leaf-wrap" data-oc-leaf data-i={i}
                   data-x={l.x} data-y={l.y} data-rot={l.rot}
                   data-target-scale={l.scale} data-progress={l.p}>
                    <use href="#oc-leaf-shape" width="72" height="44" x="-2" y="-22" />
                </g>
            ))}
        </g>

        <!-- ===== GOTAS DE FERTILIZANTE — ascienden por los tallos ===== -->
        <g class="oc__drops" data-oc-drops filter="url(#oc-drop-glow)">
            {Array.from({ length: 10 }).map((_, i) => {
                const stemIdx = i % 5;
                const scale = i === 0 ? 1.25 : 0.75 + (i % 4) * 0.12;
                return (
                    <g class={`oc__drop${i === 0 ? " oc__drop--lead" : ""}`}
                       data-oc-drop
                       data-stem={stemIdx}
                       data-i={i}
                       data-target-scale={scale}>
                        <use href="#oc-drop-shape" width="24" height="32" x="-12" y="-16" />
                    </g>
                );
            })}
        </g>
    </svg>

    <!-- Micro-mist ascendente (idle CSS, no compite con scrub) -->
    <div class="oc__mist" aria-hidden="true">
        {Array.from({ length: 12 }).map((_, i) => (
            <span class="oc__mist-dot" data-i={i}
                style={`--m-delay: ${(i * 0.6).toFixed(2)}s; --m-x: ${(8 + i * 7.5) % 100}%; --m-size: ${2 + (i % 3)}px; --m-dur: ${(10 + i % 5).toFixed(1)}s;`}>
            </span>
        ))}
    </div>
</section>

<script>
    import "../scripts/organic-connector.js";
</script>

<style>
    .oc {
        position: relative;
        width: 100%;
        min-height: 55vh;
        /* Gradient continuo verde→white:
           - 0% match HumanSupport (#1f6b50 verde) → unión de un solo color, sin negro
           - 30% emerald (puente cromático hacia las plantas)
           - 62% mint pale
           - 100% match LineasEstrella (#ffffff)
           Los tallos del OC nacen del mismo verde que cierra HumanSupport, así el
           empalme entre secciones no tiene degradé a negro ni corte visible.
           El bottom termina en blanco puro = arranque seamless de LineasEstrella. */
        background:
            linear-gradient(
                180deg,
                /* FONDO UNIFORME: el mismo verde del HumanSupport en casi toda la
                   sección (HS + OC = un solo campo verde con las plantas por
                   arriba). Recién funde a blanco en el último tramo para entrar
                   seamless al catálogo (LineasEstrella es #ffffff). Pedido cliente
                   2026-07-03: "que todo eso tenga un fondo igual". */
                #1f6b50 0%,
                #1f6b50 56%,     /* verde plano/uniforme — zona de las plantas */
                #4fbf87 74%,
                #b7ead0 88%,
                #ffffff 100%
            );
        overflow: hidden;
        isolation: isolate;
        /* margin negativo para que el OC se "monte" sobre el bottom de
           HumanSupport y elimine cualquier gap/línea sub-pixel de unión.
           -8px cubre el redondeo a distintos niveles de zoom/DPR sin tapar el
           HUD (SEGUIMOS/FASE) que está a >=18px del borde. */
        margin-top: -8px;
        margin-bottom: -1px;
    }
    .oc__bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        background:
            /* Halo mint intenso en el área transitoria (mid-section)
               donde converge dark→light. Realza los tallos contra el
               emerald del gradient. Empieza en 38% para NO tocar el borde
               superior — así el top del OC queda negro plano idéntico al
               bottom de HumanSupport y la costura no se nota. */
            radial-gradient(
                ellipse 90% 35% at 50% 42%,
                rgba(167, 245, 200, 0.30) 0%,
                transparent 70%
            );
        pointer-events: none;
    }
    /* Halo de fotosíntesis — opacity sube con scroll. Bajado a top:14% para que
       su luz mint quede en la zona de plantas y NO toque la costura con
       HumanSupport (que debe seguir negra uniforme aunque el halo se encienda). */
    .oc__halo {
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 50%;
        z-index: 1;
        opacity: 0;
        will-change: opacity;
        background:
            radial-gradient(
                ellipse 65% 100% at 50% 0%,
                rgba(167, 245, 200, 0.85) 0%,
                rgba(167, 245, 200, 0.20) 50%,
                rgba(167, 245, 200, 0.0) 80%
            );
        pointer-events: none;
        mix-blend-mode: screen;
    }

    .oc__svg {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: block;
        width: 100%;
        height: 100%;
    }

    .oc__stem {
        opacity: 0.95;
        will-change: stroke-dashoffset;
    }
    .oc__stem--main {
        opacity: 1;
    }

    .oc__leaf-wrap {
        will-change: transform, opacity;
    }
    .oc__leaf-wrap use {
        filter: drop-shadow(0 2px 6px rgba(31, 94, 68, 0.30));
    }

    .oc__drop {
        will-change: transform, opacity;
        transform-box: fill-box;
        transform-origin: center;
    }
    .oc__drop--lead {
        filter: drop-shadow(0 0 14px rgba(167, 245, 200, 0.7));
    }

    /* Mist micro — partículas pequeñas idle */
    .oc__mist {
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
        overflow: hidden;
    }
    .oc__mist-dot {
        position: absolute;
        bottom: -4%;
        left: var(--m-x);
        width: var(--m-size);
        height: var(--m-size);
        border-radius: 50%;
        background: radial-gradient(
            circle at 35% 30%,
            rgba(255, 255, 255, 0.95) 0%,
            rgba(167, 245, 200, 0.6) 55%,
            transparent 78%
        );
        opacity: 0;
        filter: blur(0.5px);
        animation: oc-mist-rise var(--m-dur, 10s) linear infinite;
        animation-delay: var(--m-delay, 0s);
    }
    @keyframes oc-mist-rise {
        0%   { transform: translate3d(0, 0, 0) scale(0.6); opacity: 0; }
        18%  { opacity: 0.55; }
        55%  { transform: translate3d(8px, -55vh, 0) scale(1); opacity: 0.35; }
        90%  { opacity: 0.12; }
        100% { transform: translate3d(-6px, -110vh, 0) scale(0.4); opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .oc__stem { opacity: 0.6 !important; stroke-dashoffset: 0 !important; }
        .oc__leaf-wrap { opacity: 0.5 !important; }
        .oc__drop { opacity: 0 !important; }
        .oc__mist-dot { animation: none !important; }
        .oc__halo { opacity: 0.4 !important; }
    }

    @media (max-width: 700px) {
        .oc { min-height: 45vh; }
    }
</style>

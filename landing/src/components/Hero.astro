---
const slides = [
    {
        eyebrow: "Holistic",
        title: "HOLISTIC ELITE",
        subtitle: "Nutrición completa y superior, nutrientes en su mayor concentración y calidad.",
        href: "#linea-elite",
        image: "/assets/productos/elite.png",
        alt: "Línea Elite — fertilizantes Holistic",
        eager: true,
    },
    {
        eyebrow: "Holistic",
        title: "HOLISTIC PRO",
        subtitle: "Nutrición confiable para el cultivo diario. Formatos sólidos fáciles de dosificar.",
        href: "#linea-pro",
        image: "/assets/productos/linea-pro-fertilizante.png",
        alt: "Línea Pro — fertilizantes Holistic",
    },
    {
        eyebrow: "Holistic",
        title: "BIO ESTIMULANTE",
        subtitle: "Potenciadores orgánicos que fortalecen raíces, follaje y defensas naturales.",
        href: "#bio-estimulante",
        image: "/assets/productos/holbio.png",
        alt: "Bio Estimulante Holistic",
    },
    {
        eyebrow: "Holistic",
        title: "DAY-0",
        subtitle: "Tratamiento final antes de cosecha. Limpieza y pulido para un resultado impecable.",
        href: "#otros",
        image: "/assets/productos/day0250ml-1.jpg",
        alt: "Day-0 Holistic",
    },
];
---
<section class="hero" id="inicio" aria-roledescription="carrusel">
    <div class="hero__slider">
        {slides.map((slide, i) => (
            <article
                class:list={["hero__slide", { "is-active": i === 0 }]}
                data-slide={i}
                hidden={i !== 0}
            >
                <div class="hero__content">
                    <p class="hero__eyebrow">{slide.eyebrow}</p>
                    <h1 class="hero__title">{slide.title}</h1>
                    <p class="hero__subtitle">{slide.subtitle}</p>
                    <div class="hero__actions">
                        <a href={slide.href} class="btn btn--primary">Ver +</a>
                        <a href={slide.href} class="btn btn--ghost">Comprar</a>
                    </div>
                </div>
                <div class="hero__image">
                    <img
                        src={slide.image}
                        alt={slide.alt}
                        loading={slide.eager ? "eager" : "lazy"}
                    />
                </div>
            </article>
        ))}
    </div>

    <button class="hero__arrow hero__arrow--prev" aria-label="Anterior">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button class="hero__arrow hero__arrow--next" aria-label="Siguiente">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
    </button>

    <div class="hero__dots" role="tablist" aria-label="Paginación del slider">
        {slides.map((_, i) => (
            <button
                class:list={["hero__dot", { "is-active": i === 0 }]}
                data-dot={i}
                aria-label={`Slide ${i + 1}`}
            ></button>
        ))}
    </div>
</section>

---
// VineDivider v2 — separador orgánico cinematográfico entre ChapterSections.
// Capas:
//   - Tallo curvo dibujado por scroll (DrawSVG scrub)
//   - 4 hojas con pop + sway idle
//   - 3 esporas drifteando a lo largo del tallo (MotionPath)
//   - Fruto/decoración alusiva por variant
//   - Bloom moment: sparkles estallan en el peak del scrub
//
// Variants: leaves | roots | drops | crystals | harvest
const {
    variant = "leaves",
    from = "#2e8f6e",
    to = "#25d366",
    height = "26vh",
} = Astro.props;
const uid = Math.random().toString(36).slice(2, 7);
const gradId = `vine-grad-${variant}-${uid}`;
const stemId = `vine-stem-${variant}-${uid}`;
const glowId = `vine-glow-${variant}-${uid}`;
---
<div
    class="vine-divider"
    data-vine-divider
    data-variant={variant}
    style={`--vine-from: ${from}; --vine-to: ${to}; height: ${height};`}
    aria-hidden="true"
>
    <svg
        class="vine-divider__svg"
        viewBox="0 0 200 400"
        preserveAspectRatio="xMidYMid meet"
    >
        <defs>
            <linearGradient id={gradId} x1="50%" y1="0%" x2="50%" y2="100%">
                <stop offset="0%" stop-color={from} stop-opacity="0.85" />
                <stop offset="100%" stop-color={to} stop-opacity="0.95" />
            </linearGradient>

            <!-- Glow del tallo: feGaussianBlur + merge para dar feel de
                 "savia luminosa". stdDeviation se anima con el scrub vía GSAP. -->
            <filter id={glowId} x="-30%" y="-10%" width="160%" height="120%">
                <feGaussianBlur in="SourceGraphic" stdDeviation="0" result="blur" data-vine-glow />
                <feMerge>
                    <feMergeNode in="blur" />
                    <feMergeNode in="SourceGraphic" />
                </feMerge>
            </filter>
        </defs>

        <!-- Tallo curvo: serpentea con 4 curvas Bezier. id para MotionPath. -->
        <path
            id={stemId}
            class="vine-divider__stem"
            d="M100 0 Q130 60 80 110 Q40 160 110 220 Q150 270 90 320 Q60 365 100 400"
            fill="none"
            stroke={`url(#${gradId})`}
            stroke-width="2.5"
            stroke-linecap="round"
            filter={`url(#${glowId})`}
            data-vine-stem
        />

        <!-- 4 hojas distribuidas a lo largo del tallo -->
        <g data-vine-leaf class="vine-divider__leaf">
            <path
                d="M105 75 Q140 55 158 88 Q152 105 130 100 Q115 95 105 75 Z"
                fill={from} opacity="0.85"
            />
            <path d="M105 75 L 145 85" stroke={from} stroke-width="1" opacity="0.4" />
        </g>

        <g data-vine-leaf class="vine-divider__leaf">
            <path
                d="M75 138 Q40 118 26 152 Q34 172 60 168 Q72 162 75 138 Z"
                fill={from} opacity="0.75"
            />
            <path d="M75 138 L 38 152" stroke={from} stroke-width="1" opacity="0.4" />
        </g>

        <g data-vine-leaf class="vine-divider__leaf">
            <path
                d="M115 220 Q150 200 168 235 Q160 252 138 248 Q120 240 115 220 Z"
                fill={to} opacity="0.85"
            />
            <path d="M115 220 L 152 232" stroke={to} stroke-width="1" opacity="0.4" />
        </g>

        <g data-vine-leaf class="vine-divider__leaf">
            <path
                d="M85 305 Q50 285 38 318 Q44 340 70 336 Q82 330 85 305 Z"
                fill={to} opacity="0.78"
            />
            <path d="M85 305 L 48 318" stroke={to} stroke-width="1" opacity="0.4" />
        </g>

        <!-- Esporas drifteando por el tallo (MotionPath en runtime). -->
        <g data-vine-spores>
            <circle data-vine-spore data-stem-id={stemId} cx="0" cy="0" r="3" fill={to} opacity="0.85" />
            <circle data-vine-spore data-stem-id={stemId} cx="0" cy="0" r="2" fill={from} opacity="0.7" />
            <circle data-vine-spore data-stem-id={stemId} cx="0" cy="0" r="2.5" fill={to} opacity="0.6" />
        </g>

        <!-- Bloom: sparkles estallan al final del scrub. -->
        <g data-vine-bloom>
            <polygon data-vine-spark points="100,375 102,381 108,383 102,385 100,391 98,385 92,383 98,381" fill={to} opacity="0" />
            <polygon data-vine-spark points="80,360 81,365 86,366 81,367 80,372 79,367 74,366 79,365" fill={to} opacity="0" />
            <polygon data-vine-spark points="120,360 121,365 126,366 121,367 120,372 119,367 114,366 119,365" fill={to} opacity="0" />
            <polygon data-vine-spark points="100,355 101,358 105,359 101,360 100,363 99,360 95,359 99,358" fill={from} opacity="0" />
            <polygon data-vine-spark points="115,378 116,381 119,382 116,383 115,386 114,383 111,382 114,381" fill={from} opacity="0" />
            <polygon data-vine-spark points="85,378 86,381 89,382 86,383 85,386 84,383 81,382 84,381" fill={from} opacity="0" />
        </g>

        <!-- Elemento alusivo por variant -->
        {variant === "leaves" && (
            <g data-vine-fruit class="vine-divider__fruit">
                <path
                    d="M100 380 Q120 365 130 380 Q120 395 100 395 Q90 388 100 380 Z"
                    fill={to}
                />
                <path
                    d="M88 372 Q100 360 112 374 Q104 386 90 384 Q82 378 88 372 Z"
                    fill={to} opacity="0.75"
                />
            </g>
        )}

        {variant === "roots" && (
            <g data-vine-fruit class="vine-divider__fruit">
                <path d="M100 378 Q92 388 88 400 M100 378 Q108 390 112 400 M100 378 Q102 392 100 402 M100 378 Q90 385 78 396 M100 378 Q112 386 122 396"
                    stroke={to} stroke-width="2" stroke-linecap="round" fill="none" />
                <circle cx="100" cy="378" r="4" fill={to} />
            </g>
        )}

        {variant === "drops" && (
            <g data-vine-fruit class="vine-divider__fruit">
                <path d="M100 372 Q108 384 100 396 Q92 384 100 372 Z" fill={to} />
                <path d="M86 380 Q92 388 86 396 Q80 388 86 380 Z" fill={to} opacity="0.78" />
                <path d="M114 384 Q120 392 114 400 Q108 392 114 384 Z" fill={to} opacity="0.65" />
            </g>
        )}

        {variant === "crystals" && (
            <g data-vine-fruit class="vine-divider__fruit">
                <polygon points="100,372 110,384 100,396 90,384" fill={to} />
                <polygon points="84,378 92,386 84,396 76,386" fill={to} opacity="0.72" />
                <polygon points="116,380 122,386 116,394 110,386" fill={to} opacity="0.6" />
            </g>
        )}

        {variant === "harvest" && (
            <g data-vine-fruit class="vine-divider__fruit">
                <circle cx="100" cy="385" r="11" fill={to} />
                <ellipse cx="100" cy="372" rx="7" ry="3" fill={from} opacity="0.7" />
                <path d="M100 372 L 100 365" stroke={from} stroke-width="1.5" stroke-linecap="round" opacity="0.7" />
            </g>
        )}
    </svg>
</div>

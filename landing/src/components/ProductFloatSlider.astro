---
// ProductFloatSlider — SPYLT-style horizontal pinned slider con composición
// por capas pre-renderizadas (Base + Hero + Ruedas) + editorial cinemática
// con SplitText char-reveal, counter, chip live, ornamentos SVG, partículas
// canvas y glow shader CSS.
//
// Cada panel tiene su propio aspect-ratio (de base.png). Los layers
// usan object-fit: contain para preservar la composición original.
//
// Skills aplicadas:
//   • gsap-timeline                 → choreography multi-step
//   • gsap-scrolltrigger            → pin horizontal + scrub + snap
//                                    + entrance editorial toggleActions
//   • gsap-plugins SplitText        → headline char reveal con mask
//   • gsap-plugins CustomEase       → 'explode' en mark (overshoot)
//   • gsap-plugins DrawSVGPlugin    → ornament asterisco draw-in
//   • gsap-utils.toArray, random    → naturalismo en partículas e idle
//   • gsap-core matchMedia          → reduced-motion + responsive
//   • gsap-performance              → transforms only, will-change
//
// Layout: editorial absolute izq, card absolute der, meta absolute bajo
// card. Particles + noise overlay al fondo del pin-wrap.
import { panels } from "../data/panels.js";

// Prop legacy. Welcome screen del slider eliminado (VideoHero ya intro).
const { showWelcome: _legacyShowWelcome = false } = Astro.props;
---
<section
    class="psl"
    data-product-slider
    aria-roledescription="carousel"
    aria-label="9 productos Holistic"
    id="productos"
>
    <div class="psl__pin-wrap" data-psl-pin-wrap>

        <!-- Particles canvas — fondo del pin, parallax mouse+scroll,
             color tint per panel via fillStyle desde el script. -->
        <canvas class="psl__particles" data-psl-particles aria-hidden="true"></canvas>

        <!-- Grain noise overlay — textura sutil de papel/film -->
        <div class="psl__noise" aria-hidden="true"></div>

        <!-- Glow ambient — radial gradients que cambian color con panel -->
        <div class="psl__glow" data-psl-glow aria-hidden="true"></div>

        <!-- Counter gigante — "06/09" en serif italic flotante.
             Se posiciona top-right ABSOLUTE en pin-wrap. -->
        <div class="psl__counter" data-psl-counter aria-hidden="true">
            <span class="psl__counter-current" data-psl-counter-current>
                <span class="psl__counter-digit" data-counter-digit>0</span><span class="psl__counter-digit" data-counter-digit>1</span>
            </span>
            <span class="psl__counter-divider"></span>
            <span class="psl__counter-total">{String(panels.length).padStart(2, "0")}</span>
        </div>

        <!-- Editorial — heading cinemática con SplitText char reveal -->
        <header class="psl__editorial" data-psl-editorial>
            <!-- Chip live: panel actualmente visible -->
            <p class="psl__editorial-chip" data-psl-editorial-chip>
                <span class="psl__editorial-dot" aria-hidden="true"></span>
                <span class="psl__editorial-chip-eyebrow">EN ESCENA</span>
                <span class="psl__editorial-chip-sep" aria-hidden="true">·</span>
                <span class="psl__editorial-chip-name" data-psl-editorial-chip-name>{panels[0].nombre}</span>
            </p>

            <h2 class="psl__editorial-h" data-psl-editorial-h>
                <span class="psl__editorial-line" data-psl-editorial-line>
                    <span class="psl__editorial-line-inner">TENEMOS</span>
                </span>
                <span class="psl__editorial-line psl__editorial-line--big" data-psl-editorial-line>
                    <span class="psl__editorial-line-inner">
                        <span class="psl__editorial-six">6</span>&nbsp;PRODUCTOS
                    </span>
                </span>
                <span class="psl__editorial-line psl__editorial-line--mark-row" data-psl-editorial-line>
                    <span class="psl__editorial-line-inner">
                        <!-- Asterisco SVG ornament: se dibuja con DrawSVG -->
                        <svg class="psl__editorial-asterisk" data-psl-asterisk
                             viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                            <g stroke="currentColor" stroke-width="2.5"
                               stroke-linecap="round" fill="none">
                                <path d="M12 4 L12 20"/>
                                <path d="M4 12 L20 12"/>
                                <path d="M6.3 6.3 L17.7 17.7"/>
                                <path d="M17.7 6.3 L6.3 17.7"/>
                            </g>
                        </svg>
                        <mark class="psl__editorial-mark" data-psl-editorial-mark>INSANAMENTE</mark>
                    </span>
                </span>
                <span class="psl__editorial-line" data-psl-editorial-line>
                    <span class="psl__editorial-line-inner">EFECTIVOS<span class="psl__editorial-period">.</span></span>
                </span>
            </h2>

            <p class="psl__editorial-sub" data-psl-editorial-sub>
                <span class="psl__editorial-sub-mark">·</span>
                Del esqueje al corte — fertilización de precisión
                <em>diseñada con cabeza, cultivada con manos.</em>
            </p>
        </header>

        <!-- Track con panels -->
        <div class="psl__track" data-psl-track>
            {panels.map((p, i) => {
                const num = String(i + 1).padStart(2, "0");
                const wheels = p.layers.wheels ?? [];
                return (
                    <article
                        class={`psl__panel${i === 0 ? " is-active" : ""}`}
                        data-psl-panel
                        data-index={i}
                        data-slug={p.slug}
                        data-nombre={p.nombre}
                        style={`--psl-bg: ${p.bgColor}; --psl-accent: ${p.accentColor}; --psl-aspect: ${p.aspect};`}
                        role="group"
                        aria-roledescription="slide"
                        aria-label={`${i + 1} de ${panels.length}: ${p.nombre}`}
                    >
                        <span class="psl__panel-step" aria-hidden="true">{num}</span>
                        <p class="psl__panel-line">LÍNEA {p.linea}</p>

                        <div class="psl__card" data-psl-card>
                            <span class="psl__card-shadow" aria-hidden="true"></span>

                            <img
                                class="psl__layer psl__layer--base"
                                src={p.layers.base}
                                alt=""
                                aria-hidden="true"
                                data-psl-base
                                draggable="false"
                                loading={i === 0 ? "eager" : "lazy"}
                            />

                            {wheels.map((w, k) => (
                                <img
                                    class="psl__layer psl__layer--wheel"
                                    data-psl-wheel
                                    data-wheel-index={k}
                                    src={w}
                                    alt=""
                                    aria-hidden="true"
                                    draggable="false"
                                    loading="lazy"
                                />
                            ))}

                            <img
                                class="psl__layer psl__layer--hero"
                                src={p.layers.hero}
                                alt={p.nombre}
                                data-psl-hero
                                draggable="false"
                                loading={i === 0 ? "eager" : "lazy"}
                            />

                            {p.label && (
                                <span class="psl__layer psl__layer--label" data-psl-label aria-hidden="true">
                                    {p.label}
                                </span>
                            )}
                        </div>

                        <footer class="psl__panel-meta">
                            <a
                                class="psl__panel-cta"
                                href={p.route}
                                data-cursor="hover"
                                data-magnetic
                                data-magnetic-strength="0.2"
                                aria-label={`Ver producto ${p.nombre}`}
                            >
                                <span>VER PRODUCTO</span>
                                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                                    <path d="M5 12h14M13 6l6 6-6 6"
                                          stroke="currentColor" stroke-width="2"
                                          fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </a>
                        </footer>
                    </article>
                );
            })}
        </div>

        <!-- HUD bottom -->
        <div class="psl__hud">
            <div class="psl__hud-counter" aria-hidden="true">
                <span class="psl__hud-num" data-psl-hud-num>01</span>
                <span class="psl__hud-sep">/</span>
                <span class="psl__hud-total">{String(panels.length).padStart(2, "0")}</span>
            </div>
            <div class="psl__hud-steps" role="tablist" aria-label="Productos">
                {panels.map((p, i) => (
                    <button
                        class={`psl__hud-step${i === 0 ? " is-active" : ""}`}
                        data-psl-step
                        data-index={i}
                        role="tab"
                        aria-label={`Ir a ${p.nombre}`}
                        aria-selected={i === 0 ? "true" : "false"}
                        type="button"
                        data-cursor="hover"
                    ></button>
                ))}
            </div>
            <p class="psl__hud-hint" aria-hidden="true">
                <span class="psl__hud-hint-icon">↓</span>
                <span>SCROLL</span>
            </p>
        </div>
    </div>
</section>

<script>
    import "../scripts/product-float-slider.js";
</script>

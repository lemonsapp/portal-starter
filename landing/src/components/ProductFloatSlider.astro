---
// ProductFloatSlider — SPYLT-style horizontal pinned slider con composición
// por capas pre-renderizadas (Base + Hero + Ruedas) que llegan ya
// posicionadas en su mismo canvas. Apilarlas absolute top:0/left:0 con
// object-fit: contain las preserva sin cropping ni stretch.
//
// Cada panel tiene su PROPIO aspect-ratio (de base.png) — los PRO son
// más wide (~2.27:1) y los RACE más cuadrados (~1.3-1.6:1).
//
// El label tipográfico ("RACE", "PART A", etc.) se renderiza vía CSS
// porque los texto.png originales venían cropped al bounding box en
// 6 de 9 paneles (no se podía estirar sin distorsionar).
//
// Skills aplicadas (citadas inline en el script):
//   • gsap-timeline             → entrada/idle multi-layer por panel
//   • gsap-scrolltrigger        → pin horizontal + scrub + snap
//   • gsap-scrolltrigger        → containerAnimation parallax sub-elementos
//   • gsap-utils.toArray, random→ stagger naturalista
//   • gsap-core matchMedia      → reduced-motion + breakpoint mobile
//   • gsap-performance          → transforms only, will-change controlado
import { panels } from "../data/panels.js";

// Prop showWelcome: legacy. Welcome screen del slider fue eliminado
// (el VideoHero del home cumple ese rol). Se ignora.
const { showWelcome: _legacyShowWelcome = false } = Astro.props;
---
<section
    class="psl"
    data-product-slider
    aria-roledescription="carousel"
    aria-label="9 productos Holistic"
    id="productos"
>
    <div class="psl__pin-wrap" data-psl-pin-wrap>

        <!-- Editorial headline — fixed durante el pin (estilo SPYLT
             "WE HAVE 6 FREAKING DELICIOUS FLAVORS"). -->
        <header class="psl__editorial" data-psl-editorial aria-hidden="false">
            <p class="psl__editorial-eyebrow" data-psl-editorial-eyebrow>
                <span class="psl__editorial-dot" aria-hidden="true"></span>
                <span>PORTFOLIO HOLISTIC</span>
            </p>
            <h2 class="psl__editorial-h" data-psl-editorial-h>
                <span class="psl__editorial-line" data-psl-editorial-line>TENEMOS 6</span>
                <span class="psl__editorial-line" data-psl-editorial-line>PRODUCTOS</span>
                <span class="psl__editorial-line" data-psl-editorial-line>
                    <mark class="psl__editorial-mark" data-psl-editorial-mark>INSANAMENTE</mark>
                </span>
                <span class="psl__editorial-line" data-psl-editorial-line>EFECTIVOS</span>
            </h2>
            <p class="psl__editorial-sub" data-psl-editorial-sub>
                4 etapas Línea PRO · 5 variantes Línea RACE. Fertilización
                de precisión para cada momento del cultivo.
            </p>
        </header>

        <!-- Track con panels -->
        <div class="psl__track" data-psl-track>
            {panels.map((p, i) => {
                const num = String(i + 1).padStart(2, "0");
                const wheels = p.layers.wheels ?? [];
                return (
                    <article
                        class={`psl__panel${i === 0 ? " is-active" : ""}`}
                        data-psl-panel
                        data-index={i}
                        data-slug={p.slug}
                        style={`--psl-bg: ${p.bgColor}; --psl-accent: ${p.accentColor}; --psl-aspect: ${p.aspect};`}
                        role="group"
                        aria-roledescription="slide"
                        aria-label={`${i + 1} de ${panels.length}: ${p.nombre}`}
                    >
                        <span class="psl__panel-step" aria-hidden="true">{num}</span>
                        <p class="psl__panel-line">LÍNEA {p.linea}</p>

                        <!-- Card con todas las capas apiladas (object-fit: contain
                             preserva la composición original de cada layer). -->
                        <div class="psl__card" data-psl-card>
                            <span class="psl__card-shadow" aria-hidden="true"></span>

                            <img
                                class="psl__layer psl__layer--base"
                                src={p.layers.base}
                                alt=""
                                aria-hidden="true"
                                data-psl-base
                                draggable="false"
                                loading={i === 0 ? "eager" : "lazy"}
                            />

                            {wheels.map((w, k) => (
                                <img
                                    class="psl__layer psl__layer--wheel"
                                    data-psl-wheel
                                    data-wheel-index={k}
                                    src={w}
                                    alt=""
                                    aria-hidden="true"
                                    draggable="false"
                                    loading="lazy"
                                />
                            ))}

                            <img
                                class="psl__layer psl__layer--hero"
                                src={p.layers.hero}
                                alt={p.nombre}
                                data-psl-hero
                                draggable="false"
                                loading={i === 0 ? "eager" : "lazy"}
                            />

                            <!-- Label tipográfico overlay (reemplaza texto.png).
                                 Render via CSS porque los texto.png originales
                                 venían cropped en 6 de 9 paneles. -->
                            {p.label && (
                                <span class="psl__layer psl__layer--label" data-psl-label aria-hidden="true">
                                    {p.label}
                                </span>
                            )}
                        </div>

                        <!-- Meta debajo del card — sólo CTA. El nombre del
                             producto ya lo da el label dentro del card +
                             la pill LÍNEA arriba-derecha. -->
                        <footer class="psl__panel-meta">
                            <a
                                class="psl__panel-cta"
                                href={p.route}
                                data-cursor="hover"
                                data-magnetic
                                data-magnetic-strength="0.2"
                                aria-label={`Ver producto ${p.nombre}`}
                            >
                                <span>VER PRODUCTO</span>
                                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                                    <path d="M5 12h14M13 6l6 6-6 6"
                                          stroke="currentColor" stroke-width="2"
                                          fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </a>
                        </footer>
                    </article>
                );
            })}
        </div>

        <!-- HUD bottom -->
        <div class="psl__hud">
            <div class="psl__hud-counter" aria-hidden="true">
                <span class="psl__hud-num" data-psl-hud-num>01</span>
                <span class="psl__hud-sep">/</span>
                <span class="psl__hud-total">{String(panels.length).padStart(2, "0")}</span>
            </div>
            <div class="psl__hud-steps" role="tablist" aria-label="Productos">
                {panels.map((p, i) => (
                    <button
                        class={`psl__hud-step${i === 0 ? " is-active" : ""}`}
                        data-psl-step
                        data-index={i}
                        role="tab"
                        aria-label={`Ir a ${p.nombre}`}
                        aria-selected={i === 0 ? "true" : "false"}
                        type="button"
                        data-cursor="hover"
                    ></button>
                ))}
            </div>
            <p class="psl__hud-hint" aria-hidden="true">
                <span class="psl__hud-hint-icon">↓</span>
                <span>SCROLL</span>
            </p>
        </div>
    </div>
</section>

<script>
    import "../scripts/product-float-slider.js";
</script>

---
// ProductsHero — Sección hero text-only ANTES del slider (SPYLT-pure).
// Replica el patrón de SPYLT.com "Stir up your fearless past" — texto big
// centered con char reveal scroll-driven, sin slider asociado. Justo
// después viene <ProductFloatSlider /> con el mismo texto acomodado a la
// izquierda y el slider de productos a la derecha.
//
// Skills aplicadas:
//   • gsap-plugins SplitText            → char reveal dramatic
//   • gsap-plugins CustomEase 'explode' → mark entrance overshoot
//   • gsap-timeline                     → choreography multi-step
//   • gsap-scrolltrigger scrub          → entrance scroll-LINKED
//   • gsap-core matchMedia              → prefers-reduced-motion respect
---
<section class="psh" data-products-hero>
    <header class="psh__editorial" data-psh-editorial>
        <p class="psh__eyebrow" data-psh-eyebrow>
            <span class="psh__dot" aria-hidden="true"></span>
            <span>NUESTROS PRODUCTOS</span>
        </p>

        <h2 class="psh__h" data-psh-h>
            <span class="psh__line" data-psh-line data-psh-line-idx="0">
                <span class="psh__line-inner">TENEMOS 5</span>
            </span>
            <span class="psh__line" data-psh-line data-psh-line-idx="1">
                <span class="psh__line-inner">PRODUCTOS</span>
            </span>
            <span class="psh__line psh__line--mark-row" data-psh-line data-psh-line-idx="2">
                <span class="psh__line-inner">
                    <mark class="psh__mark" data-psh-mark>OBSESIVAMENTE</mark>
                </span>
            </span>
            <span class="psh__line" data-psh-line data-psh-line-idx="3">
                <span class="psh__line-inner">DISEÑADOS.</span>
            </span>
        </h2>

        <p class="psh__sub" data-psh-sub>
            Sistema completo de fertilizantes para cultivo indoor.
            Del esqueje al corte: vegetativo, floración y cosecha.
            Sustratos compuestos, sustrato inerte e hidroponía.
        </p>
    </header>

    <!-- Conector animado: vertical line + dot que descienden desde el final
         del hero hacia el slider abajo. Stroke draws scroll-driven. El dot
         "aterriza" cerca de donde vive el eyebrow del slider, conectando
         visualmente las dos secciones. SPYLT-pure: thin hairline, brand color,
         y el bullet circular al final como anchor visual. -->
    <div class="psh__connector" data-psh-connector aria-hidden="true">
        <svg viewBox="0 0 24 240" preserveAspectRatio="xMidYMin meet" class="psh__connector-svg">
            <!-- Línea principal: dasharray full-length oculta, JS anima dashoffset -->
            <path
                d="M 12 0 L 12 220"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                pathLength="100"
                stroke-dasharray="100"
                stroke-dashoffset="100"
                data-psh-connector-line
            />
            <!-- Dot al final que pulsa cuando termina el draw -->
            <circle
                cx="12"
                cy="232"
                r="0"
                fill="currentColor"
                data-psh-connector-dot
            />
        </svg>
    </div>
</section>

<script>
    import "../scripts/products-hero.js";
</script>

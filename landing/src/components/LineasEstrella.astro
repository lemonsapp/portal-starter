---
// LineasEstrella — "slider vertical scroll-down" del home con los 3
// productos top (ELITE / RACE / PRO). Reemplaza al ProductFloatSlider
// horizontal por pedido del cliente.
//
// Arquitectura igual a <ComplementosIdeales /> para mantener
// consistencia visual del scroll vertical:
//   HEADER editorial (chars scatter→assemble GSAP) → THREAD vertical
//   DrawSVG → 3 PANELS con visual + body (alternating layout) +
//   markers numéricos en el thread.
//
// Cada panel = una "línea estrella" (Elite/Race/Pro). Imagen, color,
// data canónica copiada de panels.js (que ahora alimenta solo a
// ProductFloatSlider orphan, ya no usado en index.astro).
//
// Skills (citadas inline en el script):
//   • gsap-plugins SplitText (chars header + words name por panel)
//   • gsap-plugins DrawSVGPlugin (divider + thread vertical)
//   • gsap-plugins CustomEase ('explode' registrado en lib)
//   • gsap-scrolltrigger scrub (chars + thread + parallax)
//   • gsap-scrolltrigger toggleActions (panel entrance reversible)
//   • gsap-timeline (4 actos header + 9 pasos por panel)
//   • gsap-utils.random (scatter + idle float per-panel)
//   • gsap-utils.toArray (selectors batch)
//   • gsap-core matchMedia (reduced-motion + breakpoints)
//   • gsap-performance (transforms + opacity + will-change)

// Las 3 líneas estrella en orden cliente: ELITE → RACE → PRO.
// Misma identidad cromática que tenía cada panel del slider antiguo.
//
// VISUAL: cada panel renderea el packshot LAYERED (base + pote +
// ruedas + texto) tomado del primer sub-product de cada línea
// — replica el look "single product spotlight" que el slider
// mostraba cuando hacías click en un hotspot. Animación de entrada
// staggered por layer (base → ruedas → pote → texto) igual al
// swap del slider.
//
// Sub-products elegidos para representar cada línea:
//   ELITE → PART-1 (base + pote — texto omitido por bug pipeline)
//   RACE  → VIOLETA (base + bidon + ruedas + texto — más iconic)
//   PRO   → VEGETATIVO (base + pote + texto — green = growth)
const lineas = [
    {
        slug: "linea-elite",
        num: "01",
        kicker: "PREMIUM · FULL-CYCLE",
        nombre: "LÍNEA ELITE",
        tagline: "Dos botellas, un sistema completo.",
        body: "Part 1 aporta calcio, magnesio y micro. Part 2 entrega el NPK base. Aplicadas juntas en cada riego dan al cultivo todo lo que necesita en su justa proporción — sin antagonismos químicos.",
        href: "/linea-elite",
        ctaLabel: "VER LÍNEA ELITE",
        silhouette: "/img/slider-spylt/linea-elite/silhouette.png",
        // ELITE muestra LOS DOS POTES (PART-1 + PART-2) via la hero.png
        // unificada side-by-side, pero MANTIENE el base.png del sub
        // PART-1 (el fondo cream/dorado editorial que era el correcto).
        // El user reportó que el fondo unified base.png no era el que
        // iba — volvemos al sub-product base, conservando el pote dual.
        aspect: 1.30,            // matchea base.png sub PART-1 Elite
        layers: {
            base: "/img/slider-spylt/linea-elite/sub/parte-1/base.png",
            pote: "/img/slider-spylt/linea-elite/hero.png",  // 2 botellas juntas
        },
        bgColor: "#bd6ee6",
        haloColor: "#ecd6f8",
        accentText: "#E4C6FA",
    },
    {
        slug: "linea-race",
        num: "02",
        kicker: "HIGH-PERFORMANCE · 4 ETAPAS",
        nombre: "LÍNEA RACE",
        tagline: "4 fertilizantes, 4 etapas.",
        body: "Verde / Celeste / Violeta / Rosado. Cada bidón optimizado para la etapa específica del ciclo. Sistema de alta performance que define cada momento del cultivo.",
        href: "/linea-race",
        ctaLabel: "VER LÍNEA RACE",
        silhouette: "/img/slider-spylt/linea-race/silhouette.png",
        // Layered packshot del sub-product VIOLETA — visualmente iconic
        aspect: 1.59,
        layers: {
            base:   "/img/slider-spylt/linea-race/sub/violeta/base.png",
            pote:   "/img/slider-spylt/linea-race/sub/violeta/bidon.png",
            ruedas: "/img/slider-spylt/linea-race/sub/violeta/ruedas.png",
            texto:  "/img/slider-spylt/linea-race/sub/violeta/texto.png",
        },
        bgColor: "#c078e5",
        haloColor: "#edd9f7",
        accentText: "#E3C8F5",
    },
    {
        slug: "linea-pro",
        num: "03",
        kicker: "SÓLIDO · CONCENTRADO",
        nombre: "LÍNEA PRO",
        tagline: "4 etapas en formato sólido.",
        body: "Enraizante, Vegetativo, Pre-Floración, Floración. 100% materia activa sin agua ni conservantes. 36 meses de vida útil garantizados, dosis exacta al gramo.",
        href: "/linea-pro",
        ctaLabel: "VER LÍNEA PRO",
        silhouette: "/img/slider-spylt/linea-pro/fondo.png",
        // PRO muestra LOS 4 POTES (Enraizante/Vegetativo/Pre-flora/Flora)
        // juntos via la hero.png unificada (1800x511 — los 4 alineados).
        // Match perfecto al base.png unified celeste (1024x677 1.51).
        aspect: 1.51,
        layers: {
            base: "/img/slider-spylt/linea-pro/base.png",
            pote: "/img/slider-spylt/linea-pro/hero.png",  // 4 potes alineados
        },
        bgColor: "#9ad8f5",
        haloColor: "#e8f4fb",
        accentText: "#C9E9F7",
    },
];
---
<section class="le" data-lineas-estrella aria-label="Las 3 líneas estrella del catálogo Holistic">

    <!-- ===== THREAD SVG vertical (DrawSVG scroll-linked) ===== -->
    <svg class="le__thread" data-le-thread-svg preserveAspectRatio="none" aria-hidden="true">
        <defs>
            <linearGradient id="leThreadGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0"    stop-color="#A7F5C8" stop-opacity="0"/>
                <stop offset="0.08" stop-color="#A7F5C8" stop-opacity="0.85"/>
                <stop offset="0.92" stop-color="#A7F5C8" stop-opacity="0.85"/>
                <stop offset="1"    stop-color="#A7F5C8" stop-opacity="0"/>
            </linearGradient>
        </defs>
        <line class="le__thread-line" data-le-thread
              x1="50%" y1="0%" x2="50%" y2="100%"
              stroke="url(#leThreadGrad)" stroke-width="1.4" stroke-linecap="round"/>
    </svg>

    <!-- ===== HEADER editorial (chars-assemble) ===== -->
    <header class="le__header" data-le-header>
        <p class="le__eyebrow" data-le-eyebrow>
            <span class="le__dot" aria-hidden="true"></span>
            <span>EL CATÁLOGO · 3 LÍNEAS ESTRELLA</span>
        </p>

        <h2 class="le__h" data-le-h>
            <span class="le__line" data-le-line><span class="le__line-inner">ESTAS SON</span></span>
            <span class="le__line" data-le-line><span class="le__line-inner">NUESTRAS 3</span></span>
            <span class="le__line" data-le-line><span class="le__line-inner">LÍNEAS</span></span>
            <span class="le__line le__line--mark" data-le-line>
                <span class="le__line-inner">
                    <mark class="le__mark" data-le-mark>ESTRELLA</mark>
                </span>
            </span>
        </h2>

        <div class="le__divider" aria-hidden="true">
            <svg class="le__divider-svg" viewBox="0 0 400 16" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="leLine" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0"   stop-color="#A7F5C8" stop-opacity="0"/>
                        <stop offset="0.5" stop-color="#A7F5C8" stop-opacity="0.95"/>
                        <stop offset="1"   stop-color="#A7F5C8" stop-opacity="0"/>
                    </linearGradient>
                    <radialGradient id="leGlow">
                        <stop offset="0"   stop-color="#A7F5C8" stop-opacity="1"/>
                        <stop offset="0.5" stop-color="#A7F5C8" stop-opacity="0.45"/>
                        <stop offset="1"   stop-color="#A7F5C8" stop-opacity="0"/>
                    </radialGradient>
                </defs>
                <line class="le__divider-line" data-le-divider-line
                      x1="0" y1="8" x2="400" y2="8"
                      stroke="url(#leLine)" stroke-width="1.6" stroke-linecap="round"/>
                <circle class="le__divider-glow" data-le-divider-glow
                        cx="200" cy="8" r="14" fill="url(#leGlow)"/>
            </svg>
        </div>

        <p class="le__sub" data-le-sub>
            3 líneas estrella para el ciclo completo de cultivo.
            Premium, alta performance y formato sólido — cada una
            con su propia narrativa.
        </p>
    </header>

    <!-- ===== 3 PANELS alternating layout ===== -->
    {lineas.map((l, i) => (
        <article
            class={`le__panel le__panel--${i % 2 === 0 ? "visual-left" : "visual-right"}`}
            data-le-panel
            data-le-index={i}
            data-le-slug={l.slug}
            style={`--le-panel-accent: ${l.bgColor}; --le-panel-halo: ${l.haloColor}; --le-panel-text-accent: ${l.accentText};`}
        >
            <span class="le__panel-marker" aria-hidden="true">
                <span class="le__panel-marker-ring"></span>
                <span class="le__panel-marker-dot"></span>
            </span>

            <div class="le__panel-visual" data-le-visual>
                {l.silhouette && (
                    <img class="le__panel-silhouette" src={l.silhouette}
                         alt="" aria-hidden="true" loading="lazy" draggable="false"/>
                )}
                <span class="le__panel-blob" aria-hidden="true"></span>
                <span class="le__panel-halo" data-le-halo aria-hidden="true"></span>

                <!-- Stage layered: replica del swap del slider Race.
                     Arquitectura split:
                       • .le__panel-stage     → overflow:visible (pote/
                                                 ruedas/texto pueden
                                                 protruir = "superpuesto")
                       • .le__panel-frame     → overflow:hidden + border-
                                                 radius (clipea solo el
                                                 base.png al rounded card)
                     Esto permite que el bidón/pote sea más grande que el
                     marco sin cortarse, mientras la base queda dentro del
                     card redondeado. -->
                <div
                    class="le__panel-stage"
                    data-le-stage
                    style={`--le-aspect: ${l.aspect};`}
                    role="img"
                    aria-label={`${l.nombre} — ${l.kicker}`}
                >
                    <!-- Frame con el base clipeado por border-radius -->
                    <div class="le__panel-frame" aria-hidden="true">
                        <img
                            class="le__layer le__layer--base"
                            data-le-layer-base
                            src={l.layers.base}
                            alt="" aria-hidden="true"
                            loading="lazy" draggable="false"
                        />
                    </div>
                    <!-- Pote / ruedas / texto SOBRE el frame (no clipeados
                         por border-radius del stage). Pueden protruir. -->
                    {l.layers.ruedas && (
                        <img
                            class="le__layer le__layer--ruedas"
                            data-le-layer-ruedas
                            src={l.layers.ruedas}
                            alt="" aria-hidden="true"
                            loading="lazy" draggable="false"
                        />
                    )}
                    <img
                        class="le__layer le__layer--pote"
                        data-le-layer-pote
                        src={l.layers.pote}
                        alt={`${l.nombre} packshot`}
                        loading="lazy" draggable="false"
                    />
                    {l.layers.texto && (
                        <img
                            class="le__layer le__layer--texto"
                            data-le-layer-texto
                            src={l.layers.texto}
                            alt="" aria-hidden="true"
                            loading="lazy" draggable="false"
                        />
                    )}
                </div>
            </div>

            <div class="le__panel-body">
                <span class="le__panel-num" data-le-num aria-hidden="true">{l.num}</span>
                <p class="le__panel-kicker" data-le-kicker>
                    <span class="le__panel-kicker-dot" aria-hidden="true"></span>
                    {l.kicker}
                </p>
                <h3 class="le__panel-name" data-le-name>{l.nombre}</h3>
                <p class="le__panel-tagline" data-le-tagline>{l.tagline}</p>
                <p class="le__panel-text" data-le-text>{l.body}</p>
                <a
                    class="le__panel-cta"
                    data-le-cta
                    data-cursor="hover"
                    data-magnetic
                    data-magnetic-strength="0.18"
                    href={l.href}
                    aria-label={`Ver ficha de ${l.nombre}`}
                >
                    <span>{l.ctaLabel}</span>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6"/>
                    </svg>
                </a>
            </div>
        </article>
    ))}

</section>

<style>
    /* =====================================================================
       SECTION CONTAINER — bg cream editorial (NO dark como complementos
       para mantener jerarquía: las líneas estrella son cream + light, los
       complementos son dark cinematic).
       ===================================================================== */
    .le {
        position: relative;
        padding: clamp(80px, 14vh, 160px) clamp(20px, 5vw, 80px) clamp(80px, 12vh, 144px);
        background:
            radial-gradient(120% 80% at 50% 0%, rgba(46, 143, 110, 0.04), transparent 50%),
            radial-gradient(140% 90% at 50% 100%, rgba(46, 143, 110, 0.03), transparent 50%),
            #faf5ed;
        color: #1a1a1a;
        overflow: hidden;
        isolation: isolate;
    }
    .le::before {
        content: "";
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        top: clamp(28px, 6vh, 56px);
        width: clamp(60px, 10vw, 140px);
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(46, 143, 110, 0.45), transparent);
        pointer-events: none;
    }

    /* =====================================================================
       THREAD VERTICAL
       ===================================================================== */
    .le__thread {
        position: absolute;
        top: 0;
        left: 50%;
        width: 2px;
        height: 100%;
        transform: translateX(-50%);
        z-index: 1;
        pointer-events: none;
        opacity: 0.75;
    }
    .le__thread-line {
        stroke: #2E8F6E !important;
    }

    /* =====================================================================
       HEADER
       ===================================================================== */
    .le__header {
        position: relative;
        z-index: 3;
        text-align: center;
        max-width: min(900px, 90vw);
        margin: 0 auto clamp(80px, 14vh, 144px);
    }
    .le__eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.6em;
        margin: 0 0 clamp(24px, 4vh, 44px);
        font-family: var(--f-text);
        font-size: clamp(0.7rem, 0.9vw, 0.85rem);
        font-weight: 700;
        letter-spacing: 0.34em;
        text-transform: uppercase;
        color: rgba(26, 26, 26, 0.62);
    }
    .le__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #2E8F6E;
        box-shadow: 0 0 12px rgba(46, 143, 110, 0.6);
        display: inline-block;
    }
    .le__h {
        font-family: var(--f-display, 'Gotham', serif);
        font-weight: 900;
        font-size: clamp(2.8rem, 9vw, 7rem);
        line-height: 0.92;
        letter-spacing: -0.018em;
        text-transform: uppercase;
        margin: 0 0 clamp(28px, 5vh, 56px);
        color: #1a1a1a;
        position: relative;
        overflow: hidden; /* contiene shimmer sweep */
    }
    .le__line {
        display: block;
        padding: 0.06em 0;
        position: relative;
    }
    .le__line-inner {
        display: inline-block;
        will-change: transform;
    }
    .le__line--mark {
        padding-top: 0.02em;
    }
    /* ESTRELLA mark — pill cream con tilt editorial */
    .le__mark {
        display: inline-block;
        background: #2b2018;
        color: #fff8e7;
        padding: 0.06em 0.32em 0.04em;
        border-radius: 8px;
        transform: rotate(-1.6deg);
        transform-origin: 0 50%;
        font-size: 0.7em;
        letter-spacing: 0.04em;
        will-change: transform;
        box-shadow: 0 12px 28px rgba(43, 32, 24, 0.28);
    }
    /* Shimmer sweep diagonal */
    .le__h::after {
        content: "";
        position: absolute;
        top: 0;
        left: -120%;
        width: 60%;
        height: 100%;
        background: linear-gradient(
            105deg,
            transparent 0%,
            rgba(46, 143, 110, 0.06) 35%,
            rgba(46, 143, 110, 0.18) 50%,
            rgba(46, 143, 110, 0.06) 65%,
            transparent 100%
        );
        pointer-events: none;
        animation: le-shimmer 9s cubic-bezier(.55, .1, .35, .9) infinite;
        animation-delay: 3.4s;
        mix-blend-mode: multiply;
        z-index: 4;
    }
    @keyframes le-shimmer {
        0%, 70%, 100% { transform: translateX(0); opacity: 0; }
        72%           { opacity: 1; }
        90%           { transform: translateX(340%); opacity: 1; }
        95%           { opacity: 0; }
    }

    .le__divider {
        width: clamp(220px, 36vw, 380px);
        margin: 0 auto clamp(28px, 5vh, 48px);
        opacity: 0.92;
    }
    .le__divider-svg {
        width: 100%;
        height: 16px;
        display: block;
        overflow: visible;
    }
    .le__divider-line {
        stroke: #2E8F6E !important;
    }
    .le__divider-glow {
        filter: blur(0.5px);
        will-change: transform, opacity;
    }
    .le__sub {
        margin: 0 auto;
        max-width: 60ch;
        font-family: var(--f-text);
        font-size: clamp(0.98rem, 1.3vw, 1.18rem);
        line-height: 1.55;
        color: rgba(26, 26, 26, 0.7);
    }

    /* =====================================================================
       PANELS
       ===================================================================== */
    .le__panel {
        position: relative;
        z-index: 2;
        max-width: min(1180px, 92vw);
        margin: 0 auto clamp(80px, 14vh, 160px);
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: clamp(36px, 6vw, 72px);
        padding: clamp(40px, 6vh, 80px) 0;
    }
    .le__panel:last-of-type {
        margin-bottom: 0;
    }
    .le__panel--visual-right .le__panel-visual { order: 2; }
    .le__panel--visual-right .le__panel-body   { order: 1; }

    /* ----- Marker ----- */
    .le__panel-marker {
        position: absolute;
        top: clamp(40px, 6vh, 80px);
        left: 50%;
        transform: translate(-50%, 0);
        width: 24px; height: 24px;
        pointer-events: none;
        z-index: 4;
    }
    .le__panel-marker-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 1.5px solid rgba(46, 143, 110, 0.55);
        background: #faf5ed;
        animation: le-marker-pulse 2.6s ease-in-out infinite;
    }
    .le__panel-marker-dot {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 10px; height: 10px;
        border-radius: 50%;
        background: #2E8F6E;
        box-shadow: 0 0 12px rgba(46, 143, 110, 0.85);
    }
    @keyframes le-marker-pulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(46, 143, 110, 0.45); }
        50%      { box-shadow: 0 0 0 10px rgba(46, 143, 110, 0); }
    }

    /* ----- Visual (product image + halo + silhouette + blob) ----- */
    .le__panel-visual {
        position: relative;
        min-height: clamp(280px, 56vh, 520px);
        display: grid;
        place-items: center;
        padding: 0 clamp(16px, 2vw, 32px);
    }
    .le__panel-silhouette {
        position: absolute;
        inset: 0;
        width: 100%; height: 100%;
        object-fit: contain;
        opacity: 0.18;
        z-index: 0;
        pointer-events: none;
        filter: blur(2px);
        will-change: transform;
    }
    .le__panel-blob {
        position: absolute;
        inset: 12% 10%;
        background: var(--le-panel-accent, #bd6ee6);
        filter: blur(70px) saturate(1.15);
        opacity: 0.28;
        border-radius: 50%;
        z-index: 0;
        will-change: transform;
    }
    .le__panel-halo {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 70%;
        aspect-ratio: 1;
        border-radius: 50%;
        background:
            radial-gradient(
                circle at 50% 50%,
                color-mix(in srgb, var(--le-panel-halo, #ecd6f8) 55%, transparent) 0%,
                transparent 65%
            );
        filter: blur(30px);
        z-index: 1;
        will-change: transform, opacity;
    }
    /* ===== Stage layered (card rounded del slider Race) =====
       Reemplaza al .le__panel-img unificado. El stage es un card
       rounded con border-radius + overflow:hidden que contiene los
       layers stackeados (base + ruedas + pote + texto). Aspect-ratio
       viene del CSS variable --le-aspect (declarado inline per panel,
       proviene del aspect del base.png sub-product). */
    /* Stage: el contenedor principal — overflow:VISIBLE para que pote/
       ruedas/texto puedan protruir (superpuestos al marco rounded).
       Drop-shadow movido al frame interno (que sí está rounded). */
    .le__panel-stage {
        position: relative;
        z-index: 3;
        width: 100%;
        max-width: 540px;
        aspect-ratio: var(--le-aspect, 1.4) / 1;
        max-height: clamp(300px, 60vh, 540px);
        overflow: visible;
        will-change: transform, opacity;
    }
    /* Frame interno: SOLO contiene el base.png clipeado por rounded
       corners + drop-shadow. Pote/ruedas/texto viven afuera del frame
       y pueden extenderse por encima/debajo sin recortarse. */
    .le__panel-frame {
        position: absolute;
        inset: 0;
        border-radius: clamp(20px, 2.6vw, 38px);
        overflow: hidden;
        filter: drop-shadow(0 32px 48px rgba(0, 0, 0, 0.18));
        z-index: 1;
    }
    .le__layer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        user-select: none;
    }
    /* base.png — fondo decorativo. Dentro del frame, hereda
       border-radius. object-fit:cover llena el frame redondeado. */
    .le__layer--base {
        z-index: 1;        /* dentro del frame solo, no compite con pote */
        object-fit: cover;
        object-position: center;
        border-radius: inherit;
        will-change: opacity, transform;
    }
    /* ruedas (Race) — decorativo en posición center, contain */
    .le__layer--ruedas {
        z-index: 35;
        object-fit: contain;
        object-position: center;
        transform-origin: center;
        filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.28));
        will-change: opacity, transform;
    }
    /* pote — packshot principal del producto, contain con scale.
       Scale 1.10 default (matchea --psl-hero-scale del slider para
       unified heroes). Per-product overrides abajo. */
    .le__layer--pote {
        z-index: 40;
        object-fit: contain;
        object-position: center 55%;
        transform: scale(1.10);
        transform-origin: center 55%;
        filter:

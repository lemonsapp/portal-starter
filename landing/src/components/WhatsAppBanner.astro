---
import { CONTACTO } from "../data/contacto.js";
const {
    href = CONTACTO.whatsapp_url_with_message,
    text = "SE PARTE DE NUESTRO TEAM HOLISTIC EN WHATSAPP",
} = Astro.props;
---
<a class="banner" href={href} target="_blank" rel="noopener noreferrer">
    <div class="banner__inner">
        <span class="banner__text">{text}</span>
        <span class="banner__icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="22" height="22" fill="currentColor">
                <path d="M16 3C9.4 3 4 8.4 4 15c0 2.4.7 4.7 2 6.7L4 29l7.5-2c1.9 1 4.1 1.6 6.3 1.5h.2c6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.9c-2 0-3.9-.5-5.5-1.5l-.4-.2-4.4 1.2 1.2-4.3-.3-.4a9.9 9.9 0 1 1 9.4 5.2zm5.7-7.4c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2s-.8 1-1 1.2c-.2.2-.4.2-.7 0-.3-.2-1.3-.5-2.5-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.5s0-.4 0-.5c-.1-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.3 3.3c.2.2 2.2 3.4 5.4 4.7 3.2 1.3 3.2.9 3.8.8.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4 0-.1-.2-.2-.5-.3z"/>
            </svg>
        </span>
    </div>
</a>

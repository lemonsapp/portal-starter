---
import { CONTACTO } from "../data/contacto.js";
---
<section class="channels" id="contacto">
    <div class="channels__inner">
        <h2 class="channels__title">Canales de atención</h2>
        <p class="channels__lead">Nuestro equipo te asesora de lunes a sábados, de 10 a 19 hs. Escribinos por el canal que prefieras y coordinemos tu cultivo.</p>

        <div class="channels__grid">

            <article class="channels__card">
                <div class="channels__icon">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.1 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.6 2.8a2 2 0 0 1-.5 2.1L7.9 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2z"/></svg>
                </div>
                <h3 class="channels__card-title">Teléfono</h3>
                <p class="channels__card-text">{CONTACTO.horario}</p>
                <a href={CONTACTO.phone_url} class="channels__link">Llamar</a>
            </article>

            <article class="channels__card">
                <div class="channels__icon">
                    <svg viewBox="0 0 32 32" width="22" height="22" fill="currentColor"><path d="M16 3C9.4 3 4 8.4 4 15c0 2.4.7 4.7 2 6.7L4 29l7.5-2c1.9 1 4.1 1.6 6.3 1.5h.2c6.6 0 12-5.4 12-12S22.6 3 16 3zM21.7 17.5c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2s-.8 1-1 1.2c-.2.2-.4.2-.7 0-.3-.2-1.3-.5-2.5-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.5s0-.4 0-.5c-.1-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.3 3.3c.2.2 2.2 3.4 5.4 4.7 3.2 1.3 3.2.9 3.8.8.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4 0-.1-.2-.2-.5-.3z"/></svg>
                </div>
                <h3 class="channels__card-title">WhatsApp</h3>
                <p class="channels__card-text">Respuesta rápida durante el día</p>
                <a href={CONTACTO.whatsapp_url_with_message} target="_blank" rel="noopener noreferrer" class="channels__link">Escribir</a>
            </article>

            <article class="channels__card">
                <div class="channels__icon">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                </div>
                <h3 class="channels__card-title">Instagram &amp; Mail</h3>
                <p class="channels__card-text">{CONTACTO.instagram_handle_at} · {CONTACTO.email}</p>
                <a href={CONTACTO.instagram_url} target="_blank" rel="noopener noreferrer" class="channels__link">Seguirnos</a>
            </article>

        </div>
    </div>
</section>

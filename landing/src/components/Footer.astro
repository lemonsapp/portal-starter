---
const cols = [
    {
        heading: "Contacto",
        items: [
            { href: "https://wa.me/", label: "WhatsApp" },
            { href: "https://instagram.com/", label: "Instagram" },
            { href: "mailto:contacto@hgrowshop.com", label: "contacto@hgrowshop.com" },
        ],
    },
    {
        heading: "Info",
        items: [
            { href: "#linea-elite", label: "Línea Elite" },
            { href: "#linea-pro", label: "Línea Pro" },
            { href: "#bio-estimulante", label: "Bio Estimulante" },
            { href: "#otros", label: "Otros productos" },
        ],
    },
    {
        heading: "Legales",
        items: [
            { href: "#", label: "Términos y condiciones" },
            { href: "#", label: "Política de privacidad" },
            { href: "#", label: "Política de envíos" },
        ],
    },
];
---
<footer class="footer">
    <div class="footer__inner">
        <div class="footer__cols">
            {cols.map(col => (
                <div class="footer__col">
                    <h4 class="footer__heading">{col.heading}</h4>
                    <ul class="footer__list">
                        {col.items.map(item => (
                            <li><a href={item.href}>{item.label}</a></li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>

        <div class="footer__brand">HOLISTIC <span class="footer__reg">®</span></div>
    </div>
</footer>

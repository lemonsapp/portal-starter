---
import { CONTACTO } from "../data/contacto.js";

const cols = [
    {
        heading: "Contacto",
        items: [
            { href: CONTACTO.whatsapp_url, label: "WhatsApp", external: true },
            { href: CONTACTO.instagram_url, label: "Instagram", external: true },
            { href: CONTACTO.mailto_url, label: CONTACTO.email },
        ],
    },
    {
        heading: "Productos",
        items: [
            { href: "/linea-elite", label: "Línea Elite" },
            { href: "/linea-pro", label: "Línea Pro" },
            { href: "/linea-race", label: "Línea Race" },
            { href: "/bio-estimulante", label: "Bio Estimulante" },
            { href: "/cloner", label: "Cloner" },
            { href: "/day-0", label: "Day 0" },
        ],
    },
    {
        heading: "Legales",
        items: [
            { href: "/terminos", label: "Términos y Condiciones" },
            { href: "/privacidad", label: "Privacidad y Seguridad" },
        ],
    },
];
---
<footer class="footer">
    <div class="footer__inner">
        <div class="footer__cols">
            {cols.map(col => (
                <div class="footer__col">
                    <h4 class="footer__heading">{col.heading}</h4>
                    <ul class="footer__list">
                        {col.items.map(item => (
                            <li>
                                {item.external
                                    ? <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>
                                    : <a href={item.href}>{item.label}</a>}
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>

        <div class="footer__brand">
            <img
                class="footer__brand-img"
                src="/imagenes-web/LOGOS/LOGO-HOLISTIC-BLANCO.png"
                alt="Holistic"
                width="2000"
                height="408"
                loading="lazy"
                decoding="async"
            />
        </div>
    </div>
</footer>

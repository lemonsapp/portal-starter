---
// CycleIntro — sección narrativa pinneada con reveal scrubbed palabra por palabra.
// La animación la maneja story-animations.js (mismo orquestador que chapters).
---
<section class="cycle-intro" data-cycle-intro>
    <div class="cycle-intro__track" data-cycle-track>
        <p class="cycle-intro__line line-1" data-line>
            <span data-word>Nada</span>
            <span data-word>crece</span>
            <span data-word>solo.</span>
        </p>
        <p class="cycle-intro__line line-2" data-line>
            <span data-word>El</span>
            <span data-word>cultivo</span>
            <span data-word>es</span>
            <span data-word>un</span>
            <span data-word class="highlight" data-highlight-ciclo>ciclo.</span>
        </p>
        <p class="cycle-intro__line line-3" data-line>
            <span data-word>Y</span>
            <span data-word>nosotros</span>
            <span data-word>te</span>
            <span data-word>acompañamos</span>
        </p>
        <p class="cycle-intro__line line-4" data-line>
            <span data-word>en</span>
            <span data-word>cada</span>
            <span data-word class="highlight-verde" data-highlight-etapa>
                <span class="highlight-verde__fill" data-highlight-etapa-fill></span>
                <span class="highlight-verde__text">etapa.</span>
            </span>
        </p>
    </div>
</section>

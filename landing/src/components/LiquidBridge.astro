---
// LiquidBridge — REWRITE 2026-05-20 (v2): el blob CRUZA secciones.
//
// Iteración anterior dejaba el blob contenido en su propia section,
// generando un corte visual entre LineasEstrella y ComplementosIdeales.
// Cliente: "tiene que chorrear por encima, no se debe cortar entre
// pestañas".
//
// Solución técnica:
//   • Section minimal (height: 1px collapsada) — no ocupa espacio en
//     el flujo del layout.
//   • position: relative + overflow: visible + z-index alto.
//   • SVG con position: absolute extendido vertical (top: -40vh;
//     bottom: -40vh) → el blob VIVE PARTIENDO el border entre
//     LineasEstrella y ComplementosIdeales, sin section visible que
//     genere espacio vacío.
//   • pointer-events: none → no interfiere con interacción.
//
// El "chorreo" parte desde el bottom de LineasEstrella, atraviesa el
// border (invisible), termina dissolviendo en el top dark de
// ComplementosIdeales.
---
<div
    class="lb"
    data-liquid-bridge
    aria-hidden="true"
>
    <svg
        class="lb__svg"
        viewBox="0 0 1000 1000"
        preserveAspectRatio="xMidYMid meet"
        data-lb-svg
    >
        <defs>
            <filter id="lb-ink" x="-20%" y="-20%" width="140%" height="140%">
                <feTurbulence
                    type="fractalNoise"
                    baseFrequency="0.018 0.030"
                    numOctaves="3"
                    seed="7"
                    result="turb"
                    data-lb-turb
                />
                <feDisplacementMap
                    in="SourceGraphic"
                    in2="turb"
                    scale="22"
                    xChannelSelector="R"
                    yChannelSelector="G"
                />
            </filter>

            <!-- Gradient vertical: mint top → emerald mid → black bottom.
                 Sigue siendo el bridge cromático, ahora aplicado a un
                 blob alargado que cruza secciones. -->
            <linearGradient id="lb-blob-grad"
                gradientUnits="userSpaceOnUse"
                x1="500" y1="0" x2="500" y2="1000">
                <stop offset="0%"   stop-color="#A7F5C8" stop-opacity="0.9"/>
                <stop offset="25%"  stop-color="#3DA86E" stop-opacity="0.95"/>
                <stop offset="55%"  stop-color="#1f6b50" stop-opacity="0.97"/>
                <stop offset="85%"  stop-color="#0f3527" stop-opacity="1"/>
                <stop offset="100%" stop-color="#0a0a0a" stop-opacity="1"/>
            </linearGradient>

            <radialGradient id="lb-particle-grad" cx="50%" cy="50%" r="50%">
                <stop offset="0%"   stop-color="#FFFFFF" stop-opacity="1"/>
                <stop offset="60%"  stop-color="#A7F5C8" stop-opacity="0.8"/>
                <stop offset="100%" stop-color="#2E8F6E" stop-opacity="0"/>
            </radialGradient>
        </defs>

        <!-- ===== BLOB chorreando vertical =====
             Path morphing manual entre 4 keyframes. El blob es muy
             alargado verticalmente (1000 unidades de alto) y cruza
             la transición invisible entre las secciones. -->
        <path
            class="lb__blob"
            data-lb-blob
            filter="url(#lb-ink)"
            fill="url(#lb-blob-grad)"
            d="M 500 0 C 470 100, 460 220, 480 360 C 500 500, 490 640, 510 780 C 520 880, 500 950, 500 1000 C 500 950, 480 880, 490 780 C 510 640, 500 500, 520 360 C 540 220, 530 100, 500 0 Z"
        />

        <!-- ===== PARTICLES interiores =====
             20 partículas fluyendo por flow-path vertical sinuoso. -->
        <g class="lb__particles" data-lb-particles>
            {Array.from({ length: 24 }).map((_, i) => (
                <circle
                    class="lb__particle"
                    data-lb-particle
                    data-i={i}
                    cx="500" cy="0"
                    r={(1.5 + (i % 3) * 0.9).toFixed(1)}
                    fill="url(#lb-particle-grad)"
                />
            ))}
        </g>

        <path
            class="lb__flow-path"
            data-lb-flow-path
            d="M 500 0 C 470 200, 530 380, 500 580 C 470 760, 530 880, 500 1000"
            fill="none"
            stroke="none"
        />
    </svg>
</div>

<script>
    import "../scripts/liquid-bridge.js";
</script>

<style>
    /* SECTION COLLAPSED: el div no ocupa espacio del flujo del layout
       — height 1px + overflow visible. El SVG se extiende fuera del
       div via position absolute con top/bottom negativos.

       Resultado: el "section" no genera espacio vacío entre Líneas
       Estrella y Complementos Ideales — el blob simplemente flota
       atravesando el border de ambas secciones. */
    .lb {
        position: relative;
        width: 100%;
        height: 1px;        /* collapsada */
        overflow: visible;  /* permite SVG extenderse */
        z-index: 20;
        pointer-events: none;
    }
    .lb__svg {
        position: absolute;
        /* Extendido vertical: el blob arranca 45vh arriba (dentro de
           LineasEstrella) y se proyecta 45vh abajo (dentro de
           Complementos Ideales). Total 90vh atravesando el border
           invisible entre las dos secciones. */
        top: -45vh;
        left: 50%;
        transform: translateX(-50%);
        width: clamp(280px, 38vw, 540px);
        height: 90vh;
        display: block;
        pointer-events: none;
        overflow: visible;
    }
    .lb__blob {
        opacity: 0.96;
        will-change: transform;
        /* Sin mix-blend-mode: el blob conserva sus colores propios.
           El gradient interno (mint top → dark bottom) ya hace la
           transición cromática natural sobre los bg de cada section
           (blanco arriba, dark abajo) — la zona dark del blob se
           "funde" con el bg dark de ComplementosIdeales sin necesidad
           de blend mode. */
    }
    .lb__particle {
        opacity: 0;
        will-change: transform, opacity;
        filter: drop-shadow(0 0 5px rgba(167, 245, 200, 0.85));
    }
    .lb__flow-path {
        visibility: hidden;
    }

    @media (prefers-reduced-motion: reduce) {
        .lb__blob { opacity: 0.6 !important; }
        .lb__particle { opacity: 0 !important; }
    }

    @media (max-width: 700px) {
        .lb__svg {
            width: clamp(160px, 50vw, 280px);
            height: 70vh;
            top: -30vh;
            bottom: -40vh;
        }
    }
</style>

---
import { CTAS } from "../data/contacto.js";

const links = [
    { href: "/", label: "Inicio" },
    { href: "/linea-elite", label: "Línea Elite" },
    { href: "/linea-pro", label: "Línea Pro" },
    { href: "/bio-estimulante", label: "Bio Estimulante" },
    { href: "/cloner", label: "Cloner" },
    { href: "/day-0", label: "Day 0" },
];
---
<header class="header">
    <div class="header__inner">
        <a href="/" class="header__logo" aria-label="Holistic">
            <img src="/assets/logo.svg" alt="Holistic Growshop" width="140" height="40" />
        </a>

        <nav class="header__nav" aria-label="Navegación principal">
            {links.map(({ href, label }) => (
                <a href={href} class="header__link">{label}</a>
            ))}
        </nav>

        <div class="header__icons">
            <button class="header__icon" aria-label="Buscar">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            </button>

            {/* Sprint 14 L1+: CTA SOCIOS — punto de entrada al portal logueado.
                Reemplaza el viejo icono "Mi cuenta" por un boton pill con
                animaciones GSAP propias (entrance, idle pulse, hover ring +
                shimmer). Usa los hooks compartidos data-magnetic y data-cursor
                + un hook propio data-socios-btn para el script de animaciones. */}
            <a
                href={CTAS.mi_cuenta}
                class="header__socios-cta"
                aria-label="Acceder al portal de socios Holistic"
                data-cursor="hover"
                data-magnetic
                data-magnetic-strength="0.32"
                data-socios-btn
            >
                <span class="header__socios-cta__ring" aria-hidden="true"></span>
                <span class="header__socios-cta__inner">
                    <span class="header__socios-cta__label">SOCIOS</span>
                    <svg class="header__socios-cta__arrow" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <span class="header__socios-cta__sheen" aria-hidden="true"></span>
            </a>

            <button class="header__icon header__icon--cart" aria-label="Carrito">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6h15l-2 10H8L6 6z"/><path d="M6 6L5 3H2"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></svg>
                <span class="header__badge">0</span>
            </button>
        </div>
    </div>

    <script>
        import "../scripts/socios-button-animations.js";
    </script>
</header>

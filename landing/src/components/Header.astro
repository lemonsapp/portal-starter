---
import { CTAS } from "../data/contacto.js";

const links = [
    { href: "/", label: "Inicio" },
    { href: "/linea-elite", label: "Línea Elite" },
    { href: "/linea-race", label: "Línea Race" },
    { href: "/linea-pro", label: "Línea Pro" },
    { href: "/bio-estimulante", label: "Bio Estimulante" },
    { href: "/cloner", label: "Cloner" },
    { href: "/day-0", label: "Day 0" },
    // Sprint 14 (2026-05-23): shop con destacado mint. Compra sin registro
    // — el cliente ve que puede comprar como invitado desde el primer click.
    { href: "/shop", label: "Tienda", highlight: true },
];
---
<header class="header">
    <div class="header__inner">
        <a href="/" class="header__logo" aria-label="Holistic">
            <img src="/assets/logo.svg" alt="Holistic Growshop" width="140" height="40" />
        </a>

        <nav class="header__nav" aria-label="Navegación principal">
            {links.map(({ href, label, highlight }) => (
                <a href={href} class={highlight ? "header__link header__link--shop" : "header__link"}>
                    {highlight && (
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right:6px;vertical-align:middle;">
                            <circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/>
                            <path d="M2.5 3h2.7l2.5 12.4a1.5 1.5 0 0 0 1.5 1.2h8.7a1.5 1.5 0 0 0 1.5-1.2L21 7H6"/>
                        </svg>
                    )}
                    {label}
                </a>
            ))}
        </nav>

        <div class="header__icons">
            <button class="header__icon" aria-label="Buscar">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            </button>

            {/* Sprint 14 L1+: CTA SOCIOS — punto de entrada al portal logueado.
                Reemplaza el viejo icono "Mi cuenta" por un boton pill con
                animaciones GSAP propias (entrance, idle pulse, hover ring +
                shimmer). Usa los hooks compartidos data-magnetic y data-cursor
                + un hook propio data-socios-btn para el script de animaciones. */}
            <a
                href={CTAS.mi_cuenta}
                class="header__socios-cta"
                aria-label="Acceder al portal de socios Holistic"
                data-cursor="hover"
                data-magnetic
                data-magnetic-strength="0.32"
                data-socios-btn
            >
                <span class="header__socios-cta__ring" aria-hidden="true"></span>
                <span class="header__socios-cta__inner">
                    <span class="header__socios-cta__label">SOCIOS</span>
                    <svg class="header__socios-cta__arrow" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <span class="header__socios-cta__sheen" aria-hidden="true"></span>
            </a>

            {/* Cart link al portal /shop — el portal mantiene el carrito vivo
                en localStorage del mismo origin, así que el badge refleja el
                count real aunque el shopper haya agregado ítems desde el portal. */}
            <a
                href="/shop"
                class="header__icon header__icon--cart"
                aria-label="Ver carrito"
                data-cursor="hover"
                data-cart-link
            >
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2.5 3h2.7l2.5 12.4a1.5 1.5 0 0 0 1.5 1.2h8.7a1.5 1.5 0 0 0 1.5-1.2L21 7H6"/></svg>
                <span class="header__badge" data-cart-badge style="display:none">0</span>
            </a>

            {/* Hamburguesa — solo mobile (<960px). Abre el menú con los links. */}
            <button class="header__burger" aria-label="Abrir menú" aria-expanded="false" data-burger>
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>

    {/* Menú mobile (hamburguesa) — las opciones del topbar en celu. */}
    <div class="header__mobile" data-mobile-nav aria-hidden="true">
        <nav class="header__mobile-nav" aria-label="Navegación mobile">
            {links.map(({ href, label, highlight }) => (
                <a href={href} class={highlight ? "header__mobile-link header__mobile-link--shop" : "header__mobile-link"}>{label}</a>
            ))}
            <a href={CTAS.mi_cuenta} class="header__mobile-link header__mobile-link--socios">Portal Socios →</a>
        </nav>
    </div>

    <script is:inline>
      (function () {
        var b = document.querySelector("[data-burger]");
        var m = document.querySelector("[data-mobile-nav]");
        if (!b || !m) return;
        function set(open) {
          m.dataset.open = open ? "1" : "";
          m.setAttribute("aria-hidden", open ? "false" : "true");
          b.setAttribute("aria-expanded", open ? "true" : "false");
          b.classList.toggle("is-open", open);
        }
        b.addEventListener("click", function () { set(m.dataset.open !== "1"); });
        m.addEventListener("click", function (e) { if (e.target.tagName === "A") set(false); });
      })();
    </script>

    <script>
        import "../scripts/socios-button-animations.js";
    </script>

    {/* Hidratador del badge del carrito — vanilla JS (no React). Lee el
        mismo localStorage key que usa el portal (holistic.cart.v1) y
        sincroniza el count. Se actualiza en:
          • mount inicial
          • storage event (otra pestaña agregó/sacó)
          • holistic-cart-changed CustomEvent (mismo tab)
        Mismo contrato que client/src/lib/useCart.js. */}
    <script is:inline>
      (function () {
        var KEY = "holistic.cart.v1";
        var badge = document.querySelector("[data-cart-badge]");
        if (!badge) return;
        function read() {
          try {
            var raw = localStorage.getItem(KEY);
            if (!raw) return [];
            var arr = JSON.parse(raw);
            return Array.isArray(arr) ? arr : [];
          } catch (e) { return []; }
        }
        function paint() {
          var items = read();
          var count = items.reduce(function (acc, i) { return acc + (Number(i.quantity) || 0); }, 0);
          if (count > 0) {
            badge.textContent = String(count);
            badge.style.display = "";
          } else {
            badge.style.display = "none";
          }
        }
        paint();
        window.addEventListener("storage", function (e) { if (e.key === KEY) paint(); });
        window.addEventListener("holistic-cart-changed", paint);
      })();
    </script>
</header>

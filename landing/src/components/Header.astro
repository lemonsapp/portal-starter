---
import { CTAS } from "../data/contacto.js";
import { productos } from "../data/productos.js";

const links = [
    { href: "/", label: "Inicio" },
    { href: "/linea-elite", label: "Línea Elite" },
    { href: "/linea-race", label: "Línea Race" },
    { href: "/linea-pro", label: "Línea Pro" },
    { href: "/bio-estimulante", label: "Bio Estimulante" },
    { href: "/cloner", label: "Cloner" },
    { href: "/day-0", label: "Day 0" },
    // Sprint 14 (2026-05-23): shop con destacado mint. Compra sin registro
    // — el cliente ve que puede comprar como invitado desde el primer click.
    { href: "/shop", label: "Tienda", highlight: true },
];

// Índice del buscador de la lupa: secciones del sitio + catálogo completo.
// Los productos linkean a /shop?q=<nombre> (Shop.jsx ya filtra por ?q=).
const searchIndex = [
    ...links
        .filter((l) => l.href !== "/")
        .map((l) => ({ label: l.label, href: l.href, tipo: "seccion" })),
    ...productos.map((p) => ({
        label: p.nombre,
        href: `/shop?q=${encodeURIComponent(p.nombre)}`,
        tipo: "producto",
        precio: p.precio,
        imagen: p.imagen,
    })),
];
---
<header class="header">
    <div class="header__inner">
        <a href="/" class="header__logo" aria-label="Holistic">
            <img src="/imagenes-web/marca/logo.svg" alt="Holistic" width="140" height="40" />
        </a>

        <nav class="header__nav" aria-label="Navegación principal">
            {links.map(({ href, label, highlight }) => (
                <a href={href} class={highlight ? "header__link header__link--shop" : "header__link"}>
                    {highlight && (
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right:6px;vertical-align:middle;">
                            <circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/>
                            <path d="M2.5 3h2.7l2.5 12.4a1.5 1.5 0 0 0 1.5 1.2h8.7a1.5 1.5 0 0 0 1.5-1.2L21 7H6"/>
                        </svg>
                    )}
                    {label}
                </a>
            ))}
        </nav>

        <div class="header__icons">
            <button class="header__icon" aria-label="Buscar" aria-expanded="false" data-search-open data-cursor="hover">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            </button>

            {/* Sprint 14 L1+: CTA SOCIOS — punto de entrada al portal logueado.
                Reemplaza el viejo icono "Mi cuenta" por un boton pill con
                animaciones GSAP propias (entrance, idle pulse, hover ring +
                shimmer). Usa los hooks compartidos data-magnetic y data-cursor
                + un hook propio data-socios-btn para el script de animaciones. */}
            <a
                href={CTAS.mi_cuenta}
                class="header__socios-cta"
                aria-label="Acceder al portal de socios Holistic"
                data-cursor="hover"
                data-magnetic
                data-magnetic-strength="0.32"
                data-socios-btn
            >
                <span class="header__socios-cta__ring" aria-hidden="true"></span>
                <span class="header__socios-cta__inner">
                    <span class="header__socios-cta__label">SOCIOS</span>
                    <svg class="header__socios-cta__arrow" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <span class="header__socios-cta__sheen" aria-hidden="true"></span>
            </a>

            {/* Cart link al portal /shop — el portal mantiene el carrito vivo
                en localStorage del mismo origin, así que el badge refleja el
                count real aunque el shopper haya agregado ítems desde el portal. */}
            <a
                href="/shop"
                class="header__icon header__icon--cart"
                aria-label="Ver carrito"
                data-cursor="hover"
                data-cart-link
            >
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2.5 3h2.7l2.5 12.4a1.5 1.5 0 0 0 1.5 1.2h8.7a1.5 1.5 0 0 0 1.5-1.2L21 7H6"/></svg>
                <span class="header__badge" data-cart-badge style="display:none">0</span>
            </a>

            {/* Hamburguesa — solo mobile (<960px). Abre el menú con los links. */}
            <button class="header__burger" aria-label="Abrir menú" aria-expanded="false" data-burger>
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>

    {/* Buscador de la lupa — overlay bajo el header, web y mobile.
        Busca en secciones + catálogo (índice generado en build). Enter
        manda a /shop?q=<query>; cada resultado linkea directo. */}
    <div class="header__search" data-search-panel aria-hidden="true">
        <div class="header__search-inner" role="dialog" aria-modal="true" aria-label="Buscar en el sitio">
            <form class="header__search-form" data-search-form role="search">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                <input
                    type="search"
                    class="header__search-input"
                    placeholder="Buscar productos…"
                    aria-label="Buscar productos"
                    autocomplete="off"
                    autocapitalize="off"
                    spellcheck="false"
                    data-search-input
                />
                <button type="button" class="header__search-close" aria-label="Cerrar buscador" data-search-close>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
            </form>
            <ul class="header__search-results" data-search-results></ul>
        </div>
    </div>
    <script type="application/json" data-search-index set:html={JSON.stringify(searchIndex)}></script>
    <script is:inline>
      (function () {
        var panel = document.querySelector("[data-search-panel]");
        var openBtn = document.querySelector("[data-search-open]");
        var closeBtn = document.querySelector("[data-search-close]");
        var form = document.querySelector("[data-search-form]");
        var input = document.querySelector("[data-search-input]");
        var list = document.querySelector("[data-search-results]");
        var indexEl = document.querySelector("[data-search-index]");
        if (!panel || !openBtn || !form || !input || !list || !indexEl) return;

        var items = [];
        try { items = JSON.parse(indexEl.textContent) || []; } catch (e) { items = []; }

        function norm(s) {
          return String(s || "")
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "");
        }
        items.forEach(function (it) { it._n = norm(it.label); });

        function precio(n) {
          try { return "$ " + Number(n).toLocaleString("es-AR"); }
          catch (e) { return "$ " + n; }
        }

        function esc(s) {
          return String(s).replace(/[&<>"']/g, function (c) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
          });
        }

        var MAX = 8;
        function render(q) {
          var nq = norm(q).trim();
          var results;
          if (!nq) {
            results = items.filter(function (it) { return it.tipo === "seccion"; });
          } else {
            var tokens = nq.split(/\s+/);
            results = items.filter(function (it) {
              return tokens.every(function (t) { return it._n.indexOf(t) !== -1; });
            }).slice(0, MAX);
          }
          if (!results.length) {
            list.innerHTML =
              '<li class="header__search-empty">Sin resultados para “' + esc(q.trim()) + '”. ' +
              '<a href="/shop">Ver toda la tienda →</a></li>';
            return;
          }
          list.innerHTML = results.map(function (it) {
            var thumb = it.imagen
              ? '<img src="' + esc(it.imagen) + '" alt="" loading="lazy" width="40" height="40" />'
              : '<span class="header__search-thumb-ph" aria-hidden="true">→</span>';
            var meta = it.tipo === "producto"
              ? '<span class="header__search-price">' + precio(it.precio) + "</span>"
              : '<span class="header__search-tag">Sección</span>';
            return (
              '<li><a class="header__search-item" href="' + esc(it.href) + '">' +
              '<span class="header__search-thumb">' + thumb + "</span>" +
              '<span class="header__search-label">' + esc(it.label) + "</span>" +
              meta +
              "</a></li>"
            );
          }).join("");
        }

        function set(open) {
          panel.dataset.open = open ? "1" : "";
          panel.setAttribute("aria-hidden", open ? "false" : "true");
          openBtn.setAttribute("aria-expanded", open ? "true" : "false");
          if (open) {
            // Si el menú hamburguesa estaba abierto, cerrarlo para no superponer.
            var mob = document.querySelector("[data-mobile-nav]");
            var burger = document.querySelector("[data-burger]");
            if (mob && mob.dataset.open === "1") {
              mob.dataset.open = "";
              mob.setAttribute("aria-hidden", "true");
              if (burger) {
                burger.setAttribute("aria-expanded", "false");
                burger.classList.remove("is-open");
              }
            }
            render(input.value);
            // rAF: esperar a que el panel sea visible para que iOS acepte el focus
            requestAnimationFrame(function () { input.focus(); });
          } else {
            openBtn.focus();
          }
        }

        openBtn.addEventListener("click", function () { set(panel.dataset.open !== "1"); });
        if (closeBtn) closeBtn.addEventListener("click", function () { set(false); });
        // Abrir la hamburguesa cierra el buscador (el inverso vive en set()).
        var burgerBtn = document.querySelector("[data-burger]");
        if (burgerBtn) burgerBtn.addEventListener("click", function () {
          if (panel.dataset.open === "1") set(false);
        });
        panel.addEventListener("click", function (e) { if (e.target === panel) set(false); });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && panel.dataset.open === "1") set(false);
        });
        input.addEventListener("input", function () { render(input.value); });
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var q = input.value.trim();
          if (q) window.location.href = "/shop?q=" + encodeURIComponent(q);
        });
      })();
    </script>

    {/* Menú mobile (hamburguesa) — las opciones del topbar en celu. */}
    <div class="header__mobile" data-mobile-nav aria-hidden="true">
        <nav class="header__mobile-nav" aria-label="Navegación mobile">
            {links.map(({ href, label, highlight }) => (
                <a href={href} class={highlight ? "header__mobile-link header__mobile-link--shop" : "header__mobile-link"}>{label}</a>
            ))}
            <a href={CTAS.mi_cuenta} class="header__mobile-link header__mobile-link--socios">Portal Socios →</a>
        </nav>
    </div>

    <script is:inline>
      (function () {
        var b = document.querySelector("[data-burger]");
        var m = document.querySelector("[data-mobile-nav]");
        if (!b || !m) return;
        function set(open) {
          m.dataset.open = open ? "1" : "";
          m.setAttribute("aria-hidden", open ? "false" : "true");
          b.setAttribute("aria-expanded", open ? "true" : "false");
          b.classList.toggle("is-open", open);
        }
        b.addEventListener("click", function () { set(m.dataset.open !== "1"); });
        m.addEventListener("click", function (e) { if (e.target.tagName === "A") set(false); });
      })();
    </script>

    <script>
        import "../scripts/socios-button-animations.js";
    </script>

    {/* Hidratador del badge del carrito — vanilla JS (no React). Lee el
        mismo localStorage key que usa el portal (holistic.cart.v1) y
        sincroniza el count. Se actualiza en:
          • mount inicial
          • storage event (otra pestaña agregó/sacó)
          • holistic-cart-changed CustomEvent (mismo tab)
        Mismo contrato que client/src/lib/useCart.js. */}
    <script is:inline>
      (function () {
        var KEY = "holistic.cart.v1";
        var badge = document.querySelector("[data-cart-badge]");
        if (!badge) return;
        function read() {
          try {
            var raw = localStorage.getItem(KEY);
            if (!raw) return [];
            var arr = JSON.parse(raw);
            return Array.isArray(arr) ? arr : [];
          } catch (e) { return []; }
        }
        function paint() {
          var items = read();
          var count = items.reduce(function (acc, i) { return acc + (Number(i.quantity) || 0); }, 0);
          if (count > 0) {
            badge.textContent = String(count);
            badge.style.display = "";
          } else {
            badge.style.display = "none";
          }
        }
        paint();
        window.addEventListener("storage", function (e) { if (e.key === KEY) paint(); });
        window.addEventListener("holistic-cart-changed", paint);
      })();
    </script>
</header>

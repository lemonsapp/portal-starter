---
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoHero from "../components/VideoHero.astro";
import Marquee from "../components/Marquee.astro";
import EaseOfUse from "../components/EaseOfUse.astro";
import ProductFloatSlider from "../components/ProductFloatSlider.astro";
import LineasEstrella from "../components/LineasEstrella.astro";
import ComplementosIdeales from "../components/ComplementosIdeales.astro";
import HumanSupport from "../components/HumanSupport.astro";
import OrganicConnector from "../components/OrganicConnector.astro";
import HolisticPoints from "../components/HolisticPoints.astro";
import FinalCTA from "../components/FinalCTA.astro";
// ChapterSection + VineDivider + capitulos importes removidos:
// los chapters bio/cloner/race/elite/pro/day-0 ya no se renderean
// en el home (pedido del cliente). Los internas siguen vivas en
// /linea-elite, /linea-race, etc.
---
<BaseLayout
    title="Fertilizantes para Cultivo Indoor | Línea Pro, Elite y Race — Holistic Growshop"
    description="Holistic Growshop: sistema adaptable de fertilizantes para cultivo indoor. Línea Pro, Línea Elite, Línea Race y Bio Estimulante. pH estable, ciclo completo, resultados superiores. Envío gratis."
    canonical="/"
>
    <!-- Reemplazo del Loader.astro removido: marca la página como
         is-loaded inmediato + dispara el evento que VideoHero escucha
         para empezar a reproducir en frame 0. Sin esto, VideoHero
         esperaría 4.5s al fallback timeout. -->
    <script is:inline>
        document.documentElement.classList.add("is-loaded");
        try {
            window.dispatchEvent(new CustomEvent("loader:done"));
        } catch (_) {}
    </script>

    <!-- HERO PRINCIPAL — video cinematográfico (race-clip-04) con
         partículas + headline editorial, pausa en último frame.
         (Loader/NUTRICIÓN SUPERIOR removido: el video es lo primero.) -->
    <VideoHero />

    <!-- ASESORAMIENTO SIN CARGO — promesa humana inmediatamente
         debajo del hero. Antes estaba más abajo; el user pidió subirla
         para que sea lo primero post-video. -->
    <HumanSupport />

    <!-- CONECTOR ORGÁNICO — sistema de raíces growing scroll-driven que
         visualiza "el asesoramiento humano nutre los productos como las
         raíces nutren la planta". GSAP + DrawSVG + MotionPath. -->
    <OrganicConnector />

    <!-- Las 3 líneas estrella en formato vertical scroll-down. El
         <ProductFloatSlider /> horizontal queda como código orphan
         (no importado) por si se quisiera volver. <LineasEstrella />
         tiene la misma editorial pero con narrativa scroll vertical:
         header chars-assemble + thread DrawSVG + 3 panels alternating
         con visual + body + parallax. Skills gsap-plugins SplitText/
         DrawSVG + matchMedia + scrolltrigger. -->
    <LineasEstrella />

    <!-- COMPLEMENTOS IDEALES — sección dedicada inmediatamente
         debajo del slider. Bio + Day-0 como complementos cinematográficos
         del catálogo. Diseño distinto al header del slider: dark
         editorial spread con word-rise mask + DrawSVG divider + chips
         elastic. Skills gsap-plugins SplitText/DrawSVG + gsap-timeline. -->
    <ComplementosIdeales />

    <!-- ProductsHero ("TENEMOS 5 PRODUCTOS OBSESIVAMENTE DISEÑADOS.") +
         LiquidPour ("NUTRICIÓN SUPERIOR" warp verde) removidos por pedido
         del cliente: el slider habla por sí solo, el editorial extra
         post-slider rompía el ritmo. El Marquee dark se queda como
         transición tipográfica directa hacia EaseOfUse. -->
    <Marquee variant="dark" />

    <EaseOfUse />

    <!-- HOLISTIC POINTS — promoción del sistema de puntos en la web pública
         (antes solo vivía en el portal /coins). Tres pilares Comprá/Mostrá/
         Canjeá + premios + CTA a registro. Números alineados a SISTEMADEPUNTOS9. -->
    <HolisticPoints />

    <!-- ChapterSections + VineDividers (bio/cloner/race/elite/pro/day-0)
         removidos por pedido del cliente: el flujo del home termina en
         EaseOfUse → FinalCTA. Cada producto tiene su interna dedicada
         (linkadas desde LineasEstrella + ComplementosIdeales). -->

    <FinalCTA />

    <script>
        import "../scripts/story-animations.js";
        import "../scripts/vine-divider-animations.js";
        import "../scripts/race-slider-animations.js";
    </script>
</BaseLayout>

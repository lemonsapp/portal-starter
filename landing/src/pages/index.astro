---
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoHero from "../components/VideoHero.astro";
import ProductsHero from "../components/ProductsHero.astro";
import Marquee from "../components/Marquee.astro";
import LiquidPour from "../components/LiquidPour.astro";
import EaseOfUse from "../components/EaseOfUse.astro";
import ProductFloatSlider from "../components/ProductFloatSlider.astro";
import ChapterSection from "../components/ChapterSection.astro";
import VineDivider from "../components/VineDivider.astro";
import HumanSupport from "../components/HumanSupport.astro";
import FinalCTA from "../components/FinalCTA.astro";
import { capitulos } from "../data/capitulos.js";

// Transiciones orgánicas entre cada par de chapters. El orden de
// chapters es: bio → cloner → race → elite → pro → day-0.
// Cada divider lleva una decoración alusiva al producto que viene.
const dividers = [
    { variant: "leaves",   from: "#F7D6DC", to: "#E4D5F2" }, // bio    → cloner
    { variant: "roots",    from: "#E4D5F2", to: "#C7F0DD" }, // cloner → race
    { variant: "drops",    from: "#C7F0DD", to: "#F7F3EA" }, // race   → elite
    { variant: "crystals", from: "#F7F3EA", to: "#AEDAD4" }, // elite  → pro
    { variant: "harvest",  from: "#AEDAD4", to: "#F9E79B" }, // pro    → day-0
];
---
<BaseLayout
    title="Fertilizantes para Cultivo Indoor | Línea Pro, Elite y Race — Holistic Growshop"
    description="Holistic Growshop: sistema completo de fertilizantes para cultivo indoor. Línea Pro, Línea Elite, Línea Race y Bio Estimulante. pH estable, ciclo completo, resultados superiores. Envío gratis."
    canonical="/"
>
    <!-- Reemplazo del Loader.astro removido: marca la página como
         is-loaded inmediato + dispara el evento que VideoHero escucha
         para empezar a reproducir en frame 0. Sin esto, VideoHero
         esperaría 4.5s al fallback timeout. -->
    <script is:inline>
        document.documentElement.classList.add("is-loaded");
        try {
            window.dispatchEvent(new CustomEvent("loader:done"));
        } catch (_) {}
    </script>

    <!-- HERO PRINCIPAL — video cinematográfico (race-clip-04) con
         partículas + headline editorial, pausa en último frame.
         (Loader/NUTRICIÓN SUPERIOR removido: el video es lo primero.) -->
    <VideoHero />

    <!-- ASESORAMIENTO SIN CARGO — promesa humana inmediatamente
         debajo del hero. Antes estaba más abajo; el user pidió subirla
         para que sea lo primero post-video. -->
    <HumanSupport />

    <!-- HERO TEXT — sección text-only ANTES del slider (SPYLT-pure).
         "TENEMOS 5 PRODUCTOS OBSESIVAMENTE DISEÑADOS." big centered con
         char reveal scroll-driven. Justo después viene el slider con el
         mismo texto acomodado a la izquierda. -->
    <ProductsHero />

    <!-- 5 productos: pin horizontal SPYLT.
         showWelcome={false} oculta el welcome interno del slider:
         ya tenemos el VideoHero arriba como intro cinemática. -->
    <ProductFloatSlider showWelcome={false} />

    <Marquee variant="dark" />

    <LiquidPour />

    <EaseOfUse />

    {capitulos.map((c, i) => (
        <>
            <ChapterSection chapter={c} priority={i < 2} />
            {i < capitulos.length - 1 && (
                <VineDivider {...dividers[i]} />
            )}
        </>
    ))}

    <FinalCTA />

    <script>
        import "../scripts/story-animations.js";
        import "../scripts/vine-divider-animations.js";
        import "../scripts/race-slider-animations.js";
    </script>
</BaseLayout>

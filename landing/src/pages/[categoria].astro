---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductDeepDive from "../components/ProductDeepDive.astro";
import VineDivider from "../components/VineDivider.astro";
import FinalCTA from "../components/FinalCTA.astro";
import { capitulos } from "../data/capitulos.js";

export function getStaticPaths() {
    return capitulos.map((cap) => ({
        params: { categoria: cap.slug },
        props: { cap },
    }));
}

const { cap } = Astro.props;
// RaceCinematic (marquee de iconos + grid de 4 motion videos al final
// de /linea-race) removido por pedido del cliente. El componente sigue
// existiendo en components/ por si se reactiva más adelante, pero ya
// no se monta en ninguna interna.

// Divider hacia FinalCTA — ornamento alusivo al producto.
const ORNAMENT_BY_SLUG = {
    "bio-estimulante": { variant: "leaves" },
    "cloner":          { variant: "dna" },
    "linea-race":      { variant: "drops" },
    "linea-elite":     { variant: "crystals" },
    "linea-pro":       { variant: "blossom" },
    "day-0":           { variant: "harvest" },
};
const dv = ORNAMENT_BY_SLUG[cap.slug] || { variant: "leaves" };

// SEO optimizado desde IMAGENES-HOLISTIC/SEO-DOCS/v3. Fallback al título
// genérico si la entry de capitulos.js todavía no fue migrada.
const pageTitle = cap.seoTitle || `${cap.nombreCorto} ${cap.nombreDestacado} — Holistic Growshop`;
const pageDescription = cap.seoDescription || cap.descripcion;
const canonical = `/${cap.slug}`;
---
<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical}>
    <!-- Landing interna del producto al estilo apple.com/macbook-pro:
         hero + sticky highlights + big stat + bento + formats + system
         + pullquote + tech specs. El hero es el "primer video principal"
         de la interna. -->
    <ProductDeepDive cap={cap} />

    <VineDivider variant={dv.variant} from={cap.bgColor} to="#FFFFFF" />

    <FinalCTA />

    <script>
        import "../scripts/vine-divider-animations.js";
    </script>
</BaseLayout>
